#include <iostream>
#include "Matrix.h"

using namespace std;

int main() {
    int row, column;
    cout << "重新定義「-」(減號)運算子多載，使其能應用在矩陣減法上\n";
    cout << "輸入矩陣A及B的列數(row): ";
    cin >> row;
    cout << "輸入矩陣A及B的行數(column): ";
    cin >> column;

    Matrix a('A', row, column);
    Matrix b('B', row, column);

    Matrix c = a - b;

    cout << "\n矩陣 A - 矩陣 B 的結果為：\n";
    c.display();

    return 0;
}
實作檔-------------------------
#include <iostream>
#include <iomanip>
#include "Matrix.h"
using namespace std;

Matrix::Matrix(int m, int n) {
    row = m;
    column = n;
    element = new double* [m];
    for (int i = 0; i < m; i++) {
        element[i] = new double[n];
    }
}

Matrix::Matrix(char name, int m, int n) : Matrix(m, n) {
    cout << "輸入一 " << m << "x" << n << " 矩陣 " << name << endl;
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            cout << name << "[" << i << "][" << j << "]=";
            cin >> element[i][j];
        }
    }
}

Matrix Matrix::operator-(const Matrix& x) {
    Matrix temp(this->row, this->column);
    for (int i = 0; i < this->row; i++) {
        for (int j = 0; j < this->column; j++) {
            
            temp.element[i][j] = this->element[i][j] - x.element[i][j];
        }
    }
    return temp;
}

void Matrix::display() {
    for (int i = 0; i < row; i++) {
        for (int j = 0; j < column; j++) {
            cout  << element[i][j] << "\t";
        }
        cout << endl;
    }
}
