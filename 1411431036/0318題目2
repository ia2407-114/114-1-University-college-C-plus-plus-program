#include <iostream>
using namespace std;

#include "volume.h" 

int main()
{
    int int1, int2, int3;

    cout << "Input three integer values: ";
    cin >> int1 >> int2 >> int3;
        
    cout << "The integer volume is: "
        << volume(int1, int2, int3);
        
    double double1, double2, double3;

    cout << "\n\nInput three double values: ";
    cin >> double1 >> double2 >> double3;

    cout << "The double volume is: "
        << volume(double1, double2, double3);

    float float1, float2, float3;
    cout << "\nInput three float values: ";
    cin >> float1 >> float2 >> float3;
    cout << "The float volume is: "
        << volume(float1, float2, float3) << endl;
}
