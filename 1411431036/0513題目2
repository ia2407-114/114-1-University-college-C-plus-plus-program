}
寵物實作
#include <iostream>
#include "Pet.h"
using namespace std;

Pet::Pet() {
    cout << "執行父類別 Pet 的建構子\n";
    cout << "請輸入寵物姓名: ";
    cin >> name;
    cout << "請輸入寵物年齡: ";
    cin >> age;
}

Pet::~Pet() {
    cout << "執行父類別 Pet 的解構子\n";
}

void Pet::display() const {
    cout << "\n--- 寵物基本資料 ---" << endl;
    cout << "姓名: " << name << endl;
    cout << "年齡: " << age << " 歲" << endl;
}
