#include <iostream>
#include "Dog.h"
#include "Bird.h"
using namespace std;

int main() {
   
    cout << "建立狗狗資料" << endl;
    Dog myDog;
    myDog.display();
    myDog.display_dog();

    cout << "\n\n";

    
    cout << "建立小鳥資料" << endl;
