};

#endif
狗實作
#include <iostream>
#include "Dog.h"
using namespace std;

Dog::Dog() {
    cout << "\n執行子類別 Dog 的建構子\n";
    cout << "請輸入產仔數量: ";
    cin >> litter_size;
    cout << "請輸入奔跑速度 (km/h): ";
    cin >> run_speed;
}

Dog::~Dog() {
    cout << "執行子類別 Dog 的解構子\n";
}

void Dog::display_dog() const {
    cout << "產仔數量: " << litter_size << " 隻" << endl;
    cout << "奔跑速度: " << run_speed << " km/h" << endl;
}
