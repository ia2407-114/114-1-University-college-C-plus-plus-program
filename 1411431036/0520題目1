RECTANGLE實作
#include "Rectangle.h"
#include <iostream>


Rectangle::Rectangle(std::string n) : Shape(n) {
    length = 0.0f;
    width = 0.0f;
}

void Rectangle::data_input() {
    std::cout << "請輸入" << getName() << "的長: ";
    std::cin >> length;
    std::cout << "請輸入" << getName() << "的寬: ";
    std::cin >> width;
}

float Rectangle::getArea() {
    return length * width;
}
