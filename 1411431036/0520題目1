CUBE實作
#include "Cube.h"
#include <iostream>

Cube::Cube(std::string n) : Rectangle(n) {
    height = 0.0f;
}

void Cube::data_input() {
    
    Rectangle::data_input();

    std::cout << "請輸入長方體的高: ";
    std::cin >> height;
}

void Cube::calculate_volume() {
    
    float base_area = getArea();
       
    Shape::area(base_area);

    
    float volume = base_area * height;
    std::cout << "長方體的體積: " << volume << " 立方單位" << std::endl;
}
