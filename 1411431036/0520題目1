SHAPE實作
#include "Shape.h"
#include <iostream>

Shape::Shape(std::string n) {
    name = n;
    shape_area = 0.0f;
}

void Shape::area(float a) {
    shape_area = a;
    std::cout << "\n圖形名稱: " << name << std::endl;
    std::cout << "底圖形面積: " << shape_area << " 平方單位" << std::endl;
}

std::string Shape::getName() {
    return name;
}
