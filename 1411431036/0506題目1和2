主程式
#include <iostream>
#include "Matrix.h"

using namespace std;

int main() {
    int r, c;
    cout << "輸入矩陣的列數(row): ";
    cin >> r;
    cout << "輸入矩陣的行數(column): ";
    cin >> c;

    Matrix a(r, c);
        
    cout << "輸入 " << r << "x" << c << " 矩陣 A 的元素：" << endl;
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            cout << "A[" << i << "][" << j << "]=";
            cin >> a.element[i][j];
        }
    }
        
    !a;

    a++;

    return 0;
}
