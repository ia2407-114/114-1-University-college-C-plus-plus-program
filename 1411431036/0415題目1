pet實作檔案
#include <iostream>
#include "pet.h" 
#include "date.h" 
using namespace std;

PET::PET(const string& first, const string& last,
    const Date& dateOfBirth, const Date& dateOfHire)
    : firstName(first), 
    category(last), 
    birthDate(dateOfBirth), 
    adoptDate(dateOfHire) 
{
    cout << "PET object constructor: "
        << firstName << ' ' << category << endl;
} 

void PET::print() const {
    cout << category << ", " << firstName << " Adopted: ";
    adoptDate.printStandard();
    cout << " ("; 
    adoptDate.printUniversal();
    cout << ") Birthday: ";
    birthDate.printStandard();
    cout << " (";
    birthDate.printUniversal();
    cout << ")" << endl;
}

PET::~PET()
{        
    cout << "PET object destructor: "
        << firstName << ", " << category <<  "Bye Bye~~"<< endl;
} 

void PET::check_birth() const {
    cout << category << " " << firstName << " 的生日詳情: ";
    birthDate.printStandard(); 
    cout << endl;
}

void PET::check_adopt() const {
    cout << category << " " << firstName << " 的領養日詳情: ";
    adoptDate.printStandard();
    cout << endl;
}
