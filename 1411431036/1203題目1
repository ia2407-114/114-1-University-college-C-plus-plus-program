#include <stdio.h>

int factorial(int k) {
	// 遞迴終止條件 (Base Case): 0! = 1
	if (k == 0) {
		return 1;
	}
	
	return k * factorial(k - 1);
}

int main() {
	int n;
	double e_approx = 0;

	printf("輸入一個非負整數 n (用於計算 e 的近似項數): ");
	
	// 2. 計算 e 的近似值：e = Sum_{i=0}^{n} (1 / i!)
	for (int i = 0; i <= n; ++i) {
		int fact_i = factorial(i);	
		if (fact_i > 0) 
			e_approx += 1 / fact_i;

	}

	printf("輸入的項數 n = %d\n", n);
	printf("e 的近似值  = %.15f\n", e_approx);

	return 0;
}
