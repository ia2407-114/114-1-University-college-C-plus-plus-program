#include <stdio.h>

double approximate_pi(int);
double ballvolume(double,double);
double ballsurface(double, double);
double circlevolume(double, double, double);
double circlesurface(double, double, double);

int main(void)
{
	int num;
	double r;
	double h;
	printf("請輸入項目數量:");
	scanf_s("%d", &num);
	printf("請輸入球半徑");
	scanf_s("%lf", &r);
	printf("請輸入球的高:");
	scanf_s("%lf", &h);

	printf("pi的近似值為%lf", approximate_pi(num));
	printf("球體積的近似值為%lf", ballvolume(approximate_pi(num),r));
	printf("球表面積的近似值為%lf", ballsurface(approximate_pi(num), r));
	printf("圓柱體積的近似值為%lf", circlevolume(approximate_pi(num), r, h));
	printf("圓柱表面積的近似值為%lf", circlesurface(approximate_pi(num), r, h));



}

double approximate_pi(int n) {
	int i;
	double pi_approx = 0.0;
	double sign = 1.0;

	for (i = 0; i < n; i++) {
		double denominator = 2.0 * i + 1.0;
		pi_approx += sign * (4.0 / denominator);
		sign *= -1.0;
	}

	return pi_approx;
}

double ballvolume(double pi, double r) {
	
	
	return (4.0 / 3) * pi * r * r * r;

}
double ballsurface(double pi, double r) {


	return 4 * pi * r * r ;

}
double circlevolume(double pi, double r ,double h) {


	return  pi * r * r * h;

}
double circlesurface(double pi, double r, double h) {


	return  (2*pi * r * r) +(2 *pi *r * h);

}
