CLASSROOM實作
#include "Classroom.h"
#include <iostream>

Classroom::Classroom() : Student(), Teacher() {
    
}

void Classroom::show() {
  
    std::cout << "教室內的課堂資訊\n";
       
    std::cout << "課程編號: " << course_id << std::endl;
    std::cout << "課程名稱: " << course_name << std::endl;
    std::cout << "學分數  : " << course_credit << " 學分" << std::endl;   

    
    std::cout << "任課老師: " << Teacher::name << " (員工編號: " << Teacher::id << ")" << std::endl;
    std::cout << "修課學生: " << Student::name << " (學生學號: " << Student::id << ")" << std::endl;    
}
