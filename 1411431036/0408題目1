#include <iostream>
#include <stdexcept>
#include <iomanip>
#include "Date.h"
using namespace std;

Date::Date(int y, int m, int d) {
    setDate(y, m, d);
}

void Date::setDate(int y, int m, int d) {
    setYear(y);
    setMonth(m);
    setDay(d); 
}

void Date::setYear(int y) {
    if (y >= 0)
        year = y;
    else
        throw invalid_argument("年必須大於 0");
}

void Date::setMonth(int m) {
    if (m >= 1 && m <= 12)
        month = m;
    else
        throw invalid_argument("月必須介於1-12");
}

void Date::setDay(int d) {
    if (d >= 1 && d <= 31)
        day = d;
    else
        throw invalid_argument("無效的日期");
}

int Date::getYear() const { return year; }
int Date::getMonth() const { return month; }
int Date::getDay() const { return day; }

void Date::printAD() const {
    cout << "西元: " << year << "/" << setfill('0') << setw(2) << month
        << "/" << setw(2) << day << endl;
}

void Date::printROC() const {
    int rocYear = year - 1911;

    cout << "民國: "
        << (rocYear > 0 ? "" : "前")
        << (rocYear > 0 ? rocYear : (1911 - year + 1)) 
        << "/" << setfill('0') << setw(2) << month
        << "/" << setw(2) << day << endl;
}
