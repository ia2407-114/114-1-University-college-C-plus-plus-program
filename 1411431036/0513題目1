#include <iostream>

class Time {
    
    friend std::ostream& operator<<(std::ostream&, const Time&);
public:
    Time(int h = 10, int m = 30, int s = 16); 
    void setTime(int, int, int); 

    Time& operator++(); 
    Time operator++(int); 

private:
    unsigned int hour;   
    unsigned int minute; 
    unsigned int second; 
    void helpIncrement(); 
};

