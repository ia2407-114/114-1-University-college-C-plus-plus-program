#include <stdio.h>

#define SIZE 20 


void bubbleSort(int id[], int score[], int n);

int main(void) {
    
    int id[SIZE] = { 12, 13, 14, 15, 16, 17, 19, 21, 22, 23, 24, 26, 27, 28, 29, 31, 32, 33, 36, 37 };    
    int score[SIZE] = { 66, 67, 66, 70, 73, 74, 75, 75, 62, 32, 44, 46, 27, 12, 80, 63, 66, 90, 11, 66 };

    
    bubbleSort(id, score, SIZE);

    printf("排序後資料\n");
    printf("%-8s%s\n", "學號", "成績");

    for (int i = 0; i < SIZE; i++) {
        printf("%-8d%d\n", id[i], score[i]);
    }
       
}
void bubbleSort(int id[], int score[], int n) {
    int i, j;
    int temp_score;
    int temp_id;    
       
    for (i = 0; i < n - 1; i++) {
       
        for (j = 0; j < n - 1 - i; j++) {
           
            if (score[j] > score[j + 1]) {
                                
                temp_score = score[j];
                score[j] = score[j + 1];
                score[j + 1] = temp_score;
                
                temp_id = id[j];
                id[j] = id[j + 1];
                id[j + 1] = temp_id;
            }
        }
    }
}
