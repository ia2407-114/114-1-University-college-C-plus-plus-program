#include <stdio.h>

int main() {
    double p, r, aims, add;
    int year = 0;
    double total;

    printf("請輸入本金 p: ");
    scanf_s("%lf", &p);
    printf("請輸入年利率 r: ");
    scanf_s("%lf", &r);
    printf("請輸入每年定期定額存入金額: ");
    scanf_s("%lf", &add);
    printf("請輸入存款目標 aims: ");
    scanf_s("%lf", &aims);

    total = p;

    while (total < aims) {
        year++;
        total = total * (1 + r); // 複利生息
        total = total + add;     // 加上新存的錢
        printf("第 %d 年末，本利和 = %.2f\n", year, total);
    }

    printf("\n達成目標需 %d 年\n", year);
    return 0;
}
