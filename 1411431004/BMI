#include<stdio.h>

int main (void)
{
	float h, w,bmi;
	printf("Enter heightInMeters: ");
	scanf_s("%f", &h);
	printf("Enter weightInKilograms: ");
	scanf_s("%f",&w);
	bmi = w / (h * h);
	printf("BMI is %.1f\n",bmi);
	if (bmi < 18.5)
		printf("Underweight\n");
	else if ((18.5 <= bmi) && (bmi <= 24.9))
		printf("Normal\n");
	else if ((25 <= bmi) && (bmi <= 29.9))
		printf("Overweight\n");
	else if (30 <= bmi)
		printf("Obese\n");


	return 0;
}
