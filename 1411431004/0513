#include <iostream>
#include <string>

using namespace std;

// --- 基底類別: Pet ---
class Pet {
private:
    string name; // 姓名
    int age;     // 年齡

public:
    // 建構子
    Pet(string n, int a) : name(n), age(a) {
        cout << "Pet [" << name << "] 已建立。" << endl;
    }

    // 解構子
    virtual ~Pet() {
        cout << "Pet [" << name << "] 已解構。" << endl;
    }

    // 印出基本資料
    void printPetInfo() const {
        cout << "姓名: " << name << ", 年齡: " << age << " 歲" << endl;
    }

    // 提供衍生類別獲取姓名的方法（可選）
    string getName() const { return name; }
};

// --- 衍生類別: Dog ---
class Dog : public Pet {
private:
    int litterSize; // 產仔數量
    double runSpeed; // 奔跑速度 (km/h)

public:
    // 建構子 (透過初始化列表呼叫基底類別建構子)
    Dog(string n, int a, int ls, double rs)
        : Pet(n, a), litterSize(ls), runSpeed(rs) {
        cout << "Dog 特有資料已初始化。" << endl;
    }

    ~Dog() {
        cout << "Dog 部分已解構。" << endl;
    }

    // 印出 Dog 資料
    void printDogInfo() const {
        printPetInfo(); // 先印出基本資料
        cout << "特色資料 -> 產仔數量: " << litterSize
            << " 隻, 奔跑速度: " << runSpeed << " km/h" << endl;
    }
};

// --- 衍生類別: Bird ---
class Bird : public Pet {
private:
    int eggCount;    // 生蛋數量
    double flySpeed; // 飛行速度 (km/h)

public:
    // 建構子
    Bird(string n, int a, int ec, double fs)
        : Pet(n, a), eggCount(ec), flySpeed(fs) {
        cout << "Bird 特有資料已初始化。" << endl;
    }

    ~Bird() {
        cout << "Bird 部分已解構。" << endl;
    }

    // 印出 Bird 資料
    void printBirdInfo() const {
        printPetInfo(); // 先印出基本資料
        cout << "特色資料 -> 生蛋數量: " << eggCount
            << " 顆, 飛行速度: " << flySpeed << " km/h" << endl;
    }
};

// --- 主程式測試 ---
int main() {
    cout << "=== 測試 Dog 類別 ===" << endl;
    Dog myDog("小黃", 3, 5, 45.5);
    myDog.printDogInfo();

    cout << "\n=== 測試 Bird 類別 ===" << endl;
    Bird myBird("小藍", 1, 3, 60.0);
    myBird.printBirdInfo();

    cout << "\n=== 結束程式，執行解構子 ===" << endl;
    return 0;
}
