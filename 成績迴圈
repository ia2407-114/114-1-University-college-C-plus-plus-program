#include <stdio.h>

int main(void)
{
	int counter; 
	int grade;
	int total;
	int min;
	int max;
	float average; 

	
	total = 0; 
	counter = 0;
	min = 99999;
	max = 0;
	
	printf("%s", "Enter grade, -1 to end: "); 
	scanf_s("%d", &grade); 

	
	while (grade != -1) {
		total = total + grade;
		counter = counter + 1; 
		if (min > grade) {
			min = grade;
		}
		if (max < grade) {
			max = grade;
		}
		printf("%s", "Enter grade, -1 to end: "); 
		scanf_s("%d", &grade); 
	} 

	
	if (counter != 0) {

		
		average = (float)total / counter; 

		
		printf("Class average is %.2f\n", average);
		printf("Class max is %d\n", max);
		printf("Class min is %d\n", min);
	} 
	else { 
		puts("No grades were entered");
	} 
} 
