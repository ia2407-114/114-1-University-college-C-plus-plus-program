#include <stdio.h>
#define SIZE 10

// 排序副程式
void sort_array(int stu[3][SIZE], float avg[], int n) {
    int i, j, temp;
    float temp1;

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            if (avg[j] < avg[j + 1]) {

                temp = stu[0][j];
                stu[0][j] = stu[0][j + 1];
                stu[0][j + 1] = temp;

                temp = stu[1][j];
                stu[1][j] = stu[1][j + 1];
                stu[1][j + 1] = temp;

                temp = stu[2][j];
                stu[2][j] = stu[2][j + 1];
                stu[2][j + 1] = temp;

                temp1 = avg[j];
                avg[j] = avg[j + 1];
                avg[j + 1] = temp1;

            }
        }
    }
}

// 眾數副程式
float find_mode(float arr[], int n) {
    int i, j, max_count = 0;
    float mode = arr[0];
    for (i = 0; i < n; i++) {
        int current_count = 0;
        for (j = 0; j < n; j++) {
            if (arr[j] == arr[i]) current_count++;
        }
        if (current_count > max_count) {
            max_count = current_count;
            mode = arr[i];
        }
    }
    return mode;
}

int main() {
    int stu[3][SIZE] = { { 11, 15, 13, 18, 12, 17, 14, 19, 16, 20 },
                         { 85, 92, 78, 85, 90, 85, 76, 95, 88, 85 },
                         { 70, 80, 75, 90, 85, 70, 82, 92, 88, 70 } };
    float average_scores[SIZE];

    // 1. 計算平均 (修正索引)
    for (int i = 0; i < SIZE; i++) {
        average_scores[i] = (stu[1][i] + stu[2][i]) / 2.0;
    }

    // 2. 排序
    sort_array(stu, average_scores, SIZE);

    // 3. 印出結果 (修正輸出索引)
    printf("學號\t計概\t數學\t平均成績\n");
    for (int i = 0; i < SIZE; i++) {
        printf("%d\t%d\t%d\t%.2f\n", stu[0][i], stu[1][i], stu[2][i], average_scores[i]);
    }

    printf("\n平均分數眾數為: %.2f\n", find_mode(average_scores, SIZE));

    return 0;
}
