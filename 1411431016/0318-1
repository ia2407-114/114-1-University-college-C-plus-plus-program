#include <iostream>
#include <cstdlib>
using namespace std;


void volume(int s) {
    cout << "=> [偵測到1個數字] 正方體體積: " << s * s * s << endl;
}


void volume(int r, int h) {
    cout << "=> [偵測到2個數字] 圓柱體體積: " << 3.14 * r * r * h << endl;
}


void volume(int l, int w, int h) {
    cout << "=> [偵測到3個數字] 長方體體積: " << l * w * h << endl;
}

int main() {
    int a, b, c;

    cout << "--- 體積自動判別測試 (輸入 0 結束) ---" << endl;

    while (true) {
        cout << "請輸入 1~3 個數字 (中間加空格，輸完按 Enter): ";

        cin >> a;
        if (a == 0) break;

        
        if (cin.peek() == '\n' || cin.peek() == '\r') {
            volume(a);
        }
        else {
            cin >> b; 
            if (cin.peek() == '\n' || cin.peek() == '\r') {
                volume(a, b);
            }
            else {
                cin >> c; 
                volume(a, b, c);
            }
        }

       
        cin.ignore(100, '\n');
        cout << endl;
    }

    system("pause");
    return 0;
}
