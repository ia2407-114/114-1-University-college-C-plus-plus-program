pet.cpp
#include <iostream>
#include "pet.h"
using namespace std;

PET::PET(string name, int age) {
    
    if (name.length() > 2 && name.length() < 5) {
        petName = name;
    }
    else {
        petName = "預設名字";
        cout << "警告：名字長度不合格，已設為預設值。" << endl;
    }

    
    if (age > 20) {
        petAge = age;
    }
    else {
        petAge = 0;
        cout << "警告：年齡不合格，已設為0。" << endl;
    }
}

PET::~PET() {
    cout << "再見了，" << petName << "！" << endl;
}

void PET::displayInfo() const {
    cout << "\n--- 寵物資料顯示 ---" << endl;
    cout << "名字: " << petName << endl;
    cout << "年齡: " << petAge << endl;
}




