#include <iostream>
#include "Date.h"

using namespace std;

int main() {
    int y, m, d;
    Date t;

    cout << "請輸入西元 年 月 日 (空格隔開): ";
    cin >> y >> m >> d;

    try {
        t.setDate(y, m, d);
        cout << "\n--- 轉換結果 ---" << endl;
        cout << "西元日期: "; t.printUniversal(); cout << endl;
        cout << "民國日期: "; t.printStandard(); cout << endl;
    }
    catch (invalid_argument& e) {
        cout << "\nException: " << e.what() << endl;
    }

    return 0;
}
