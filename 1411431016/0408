#ifndef DATE_H
#define DATE_H

class Date {
public:
    Date(int = 1990, int = 1, int = 1); // 建構子
    void setDate(int, int, int);       // 設定日期
    void printUniversal() const;      // 印出西元
    void printStandard() const;       // 印出民國
private:
    unsigned int year;
    unsigned int month;
    unsigned int day;
    bool isLeapYear(int) const;       // 新增：判斷閏年的工具
};

#endif
