#include <iostream>
#include <iomanip>
#include <stdexcept>
#include "Date.h"

using namespace std;

Date::Date(int y, int m, int d) {
    setDate(y, m, d);
}

// 判斷閏年的邏輯
bool Date::isLeapYear(int y) const {
    return (y % 400 == 0) || (y % 4 == 0 && y % 100 != 0);
}

void Date::setDate(int y, int m, int d) {
    // 定義每個月的天數
    int daysInMonth[] = { 0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };

    // 如果是閏年，2月就有29天
    if (isLeapYear(y)) {
        daysInMonth[2] = 29;
    }

    // 嚴格檢查日期範圍
    if (y >= 0 && (m >= 1 && m <= 12) && (d >= 1 && d <= daysInMonth[m])) {
        year = y;
        month = m;
        day = d;
    }
    else {
        throw invalid_argument("Year, month or day out of range");
    }
}

void Date::printUniversal() const {
    cout << year << "/" << month << "/" << day;
}

void Date::printStandard() const {
    // 題目要求：民國年 = 西元年 - 1911
    cout << (year - 1911) << "/" << month << "/" << day;
}
