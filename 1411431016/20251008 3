#include<stdio.h>
int main()
{
	float height, weight, BMI;
	printf("請輸入您的身高(公尺)\n");
	scanf_s("%f", &height);
	printf("請輸入您的體重(公斤)\n");
	scanf_s("%f", &weight);
	BMI = weight / (height * height);
	printf("您的BMI是 %.1f\n", BMI);

	if (BMI <= 18.5){
		printf("過輕\n");
	}
	else if (18.6 <= BMI && BMI <= 24.9){
		printf("適中\n");
	}
	else if (25 <= BMI && BMI <= 29.9){
		printf("過重\n");
	}
	else if (BMI >= 30){
		printf("超重\n");
	}
	return 0;
}
