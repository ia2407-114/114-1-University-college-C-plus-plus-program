#include <iostream>
using namespace std;

int volume(int s) {
    cout << "正方體體積 (邊長 " << s << "): ";
    return s * s * s;
}

double volume(int r, int h) {
    double pi = 3.14159;
    cout << "圓柱體體積 (半徑 " << r << ", 高 " << h << "): ";
    return r * r * pi * h;
}

int volume(int l, int w, int h) {
    cout << "長方體體積 (長 " << l << ", 寬 " << w << ", 高 " << h << "): ";
    return l * w * h;
}

int main() {

    cout << volume(7) << endl;

    cout << volume(5, 10) << endl;

    cout << volume(5, 6, 7) << endl;

    return 0;
}


