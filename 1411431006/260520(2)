// 題目2:（多重繼承）寫一程式，定義類別student，其成員變數有編號id、姓名name(使用建構子函數輸入)。再定義類別teacher，其成員變數有編號id、姓名name(使用建構子函數輸入)、課程編號course_id、課程名稱course_name 與學分course_credit，及成員函式data_input( )作為教師的課程編號、課程名稱與學分輸入之用。最後定義同時繼承teacher及student的衍生類別classroom，且其成員函式為show()，用來顯示此classroom內的課程資料、課程名稱與學分，以及教師與學生的姓名。

#include <iostream>
#include <string>

using namespace std;

class student {
public:
    string id;
    string name;

    student(string s_id, string s_name) {
        id = s_id;
        name = s_name;
    }
};

class teacher {
public:
    string id;
    string name;
    string course_id;
    string course_name;
    int course_credit;

    teacher(string t_id, string t_name) {
        id = t_id;
        name = t_name;
        course_id = "";
        course_name = "";
        course_credit = 0;
    }

    void data_input() {
        cout << "--- 請輸入教師的授課資料 ---" << endl;
        cout << "請輸入課程編號: ";
        cin >> course_id;
        cout << "請輸入課程名稱: ";
        cin >> course_name;
        cout << "請輸入課程學分: ";
        cin >> course_credit;
    }
};

class classroom : public teacher, public student {
public:

    classroom(string t_id, string t_name, string s_id, string s_name)
        : teacher(t_id, t_name), student(s_id, s_name) {
    
    }

    void show() {
        cout << "\n========================================" << endl;
        cout << "           教室 (Classroom) 資料呈現      " << endl;
        cout << "========================================" << endl;
        cout << "課程編號: " << course_id << endl;
        cout << "課程名稱: " << course_name << endl;
        cout << "課程學分: " << course_credit << " 學分" << endl;
        cout << "----------------------------------------" << endl;
       
        cout << "授課教師: " << teacher::name << " (編號: " << teacher::id << ")" << endl;
        cout << "修課學生: " << student::name << " (學號: " << student::id << ")" << endl;
        cout << "========================================" << endl;
    }
};

int main() {
    string t_id, t_name, s_id, s_name;

    cout << "=== 初始化教室成員資料 ===" << endl;
    cout << "請輸入教師員工編號: ";
    cin >> t_id;
    cout << "請輸入教師姓名: ";
    cin >> t_name;
    cout << "請輸入學生學號: ";
    cin >> s_id;
    cout << "請輸入學生姓名: ";
    cin >> s_name;
    cout << endl;

    classroom my_classroom(t_id, t_name, s_id, s_name);

    my_classroom.data_input();

    my_classroom.show();

    return 0;
}

