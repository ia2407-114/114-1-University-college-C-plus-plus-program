/*題目3. 承上題根據fig11_11.c的檔案內容，利用已建立的空白隨機存取檔，存入3筆學生資料，學生的結構(struct)為:

struct student {
 int id;
    char name[20];
    int computer, math;
    double avg;
};
*/

#include <stdio.h>


struct student {
    int id;
    char name[20];
    int computer, math;
    double avg;
};


int main(void) {
    FILE *cfPtr;


    if ((cfPtr = fopen("accounts.dat", "rb+")) == NULL) {
        puts("File could not be opened.");
    } 
    else {
        struct student client = {0, "", 0, 0, 0.0};


        for (int i = 0; i < 3; i++) {
            printf("Enter id (1-100), name, computer score, math score: ");
            scanf("%d %19s %d %d", &client.id, client.name, &client.computer, &client.math);
            
            client.avg = (client.computer + client.math) / 2.0;


            fseek(cfPtr, (client.id - 1) * sizeof(struct student), SEEK_SET);
            fwrite(&client, sizeof(struct student), 1, cfPtr);
        }


        fclose(cfPtr);
    }


    return 0;
}


