//題目一、印出總和、平均數、乘積、最小值、最大值

#include <stdio.h>

int main(void)
{
    int x, y, z;

    printf("請輸入三個不同的整數:\n");
    scanf_s("%d %d %d", &x, &y, &z);

    printf("Sum is %d\n", x + y + z);
    printf("Average is %.2f\n", (float)(x + y + z) / 3);
    printf("Product is %d\n", x * y * z);

    // 判斷最大值
    if(x>y){
        if(x>z)
            printf("Largest is %d\n", x);
        else
            printf("Largest is %d\n", z);
    }
    else
    {
        if(y>z)
            printf("Largest is %d\n", y);
        else
            printf("Largest is %d\n", z);
	}

    // 判斷最小值
    if(x<y){
        if(x<z)
            printf("Smallest is %d\n", x);
        else
            printf("Smallest is %d\n", z);
    }
    else
    {
        if (y < z)
            printf("Smallest is %d\n", y);
        else
            printf("Smallest is %d\n", z);
    }

    return 0;
}

//題目二、輸入使用者的體重(磅或是公斤)、身高(吋或是公尺)，計算使用者的BMI

#include <stdio.h>

int main(void)
{
	//輸入身高&體重
	float height, weight, bmi;
	printf("請輸入您的身高(公尺):");
	scanf_s("%f", &height);
	printf("請輸入您的體重(公斤):");
	scanf_s("%f", &weight);

	//計算BMI
	bmi = weight / (height * height);
	{
		if (bmi < 18.5)
			puts("過輕");
		else if (bmi >= 18.5 && bmi < 24)
			puts("適中");
		else 
			puts("過重");
	}

	//印出結果
	printf("您的BMI為:%.2f\n", bmi);

	return 0;
}

// 題目三、輸入學生成績，直到輸入負數即停止，印出學生的平均成績(浮點數)、最高成績、最低成績

#include <stdio.h>

int main(void)
{
    unsigned int counter;  
    int grade;             
    int total;            
    int max;              
    int min;               
    float average; 

    // 初始化階段
    total = 0;
    counter = 0;

    // 輸入第一筆
    printf("請輸入成績，輸入負數即結束: ");
    scanf_s("%d", &grade);

    // 若第一筆就是負數，表示沒有輸入有效成績
    if (grade < 0) {
        puts("未輸入任何成績。");
        return 0; 
    }

    // 初始化 max/min
    max = grade;
    min = grade;
    total = grade;
    counter = 1;

    // 進入哨兵控制的迴圈
    printf("請輸入成績，-1 結束: ");
    scanf_s("%d", &grade);

    while (grade >= 0) {
        total = total + grade; 
        counter = counter + 1;

        // 檢查最高、最低
        if (grade > max)
            max = grade;
        if (grade < min)
            min = grade;

        // 繼續輸入
        printf("請輸入成績，-1 結束: ");
        scanf_s("%d", &grade);
    }

    // 結束後計算平均
    average = (float)total / counter;

    // 印出結果
    printf("\n共有 %u 筆成績\n", counter);
    printf("平均成績: %.2f\n", average);
    printf("最高成績: %d\n", max);
    printf("最低成績: %d\n", min);

    return 0;
}
