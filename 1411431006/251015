// 題目一、輸入學生成績，直到輸入負數即停止，判斷學生成績是否及格、累計及格與不及格的人數，
// 並且印出學生及格與不及格的人數、平均成績(浮點數)，如果及格人數大於等於50%，則印出 "Bouns to the Teacher!"。

#include <stdio.h>

int main(void)
{
    unsigned int counter=0; 
    int grade; 
    int total=0; 
    int passcount=0; 
    int failcount=0; 
    float average; 

//使用 do while 迴圈重複輸入成績
    do
    {
        printf("請輸入成績，輸入負數即結束: "); 
        scanf_s("%d", &grade); 

        if (grade >= 0) 
        {
            total += grade; 
            counter++; 
            if (grade >= 60) 
                passcount++; 
            else 
                failcount++;  
        }
    } while (grade >= 0); 
    
//計算並印出及格人數、不及格人數、平均成績
    if (counter > 0) { 
        average = (float)total / counter; 
        printf("\n及格人數:%d\n", passcount); 
        printf("不及格人數:%d\n", failcount); 
        printf("平均成績:%.2f\n", average);
    }

//若及格率>=50%，印出訊息
        if ((float)passcount / counter >= 0.5) 
            printf("Bouns to the Teacher!\n"); 
  
      return 0;
  }

//題目二、請輸入一個整數fact<13，印出fact的階乘值。

#include <stdio.h>

int main(void)
{
    int fact;
    int i;
    int result = 1;

    printf("請輸入一個整數 fact (<13): ");
    scanf_s("%d", &fact);

// 檢查輸入是否在有效範圍內
    if (fact < 0 || fact >= 13)
    {
        printf("輸入錯誤，請輸入 0 到 12 之間的整數。\n");
        return 1;
    }
    for (i = 1; i <= fact; i++)
    {
        result *= i;
    }
    
    printf("%d! = %d\n", fact, result);

    return 0;
}

//題目三、承上題，輸入所需的項目數量term<13，
//根據此公式e=1+1/1!+1/2!+1/3!...，求出e的近似值

#include <stdio.h>

int main(void)
{
   int term;
   int i,j;
   float result=1;
   float factorial;

//輸入項數小於13的值,並檢查輸入值是否正確,重複輸入直到正確為止
   do  {
       printf("請輸入項數(term<13):\n");
       scanf_s("%d", &term);
       
       if (term < 1 || term > 12)
       {
           printf("請輸入1到12的數字!\n");
       }
   } while (term < 1 || term > 12);
   
//計算e的近似值
   for(i=1;i<term;i++)
   {
       factorial=1;
       for(j=1;j<=i;j++)
       {
           factorial=factorial*j;
       }
       result=result+1/factorial;
   }
   
   printf("項數為%d時,近似值＝%.6f\n",term,result);

   return 0;
}




