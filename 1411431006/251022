// 題目一、從鍵盤輸入本金(p=10000) 年利率(r=0.05)，
// 以及存款目標(aims)印出每年底(複利)本利合，
// 直到達成存款目標，讓使用者知道幾年才能達成目標。
// 注意! 計算次方項時，不得使用庫存函數pow( , )!!!!

#include <stdio.h>

int main(void)
{
    double p; 
    double r;     
    double aims;  
    double total; 
    int year = 0; 

    printf("請輸入本金 p: ");
    scanf_s("%lf", &p);
    printf("請輸入年利率 r: ");
    scanf_s("%lf", &r);
    printf("請輸入存款目標 aims: ");
    scanf_s("%lf", &aims);

    total = p; 
  
    while (total < aims)
    {
        total = total * (1 + r); 
        year++;
        printf("第 %d 年的本利合為 %.2lf\n", year, total);
    }

    printf("共需 %d 年才能達成目標 %.2lf 元\n", year, aims);

    return 0;
}

// 題目二、從鍵盤輸入本金(p=10000) 年利率(r=0.05)，
// 每個年底定期定額存入金額，以及存款目標(aims)印出每年底(複利)本利合，
// 直到達成存款目標，讓使用者知道幾年才能達成目標。
// 注意! 計算次方項時，不得使用庫存函數pow( , )!!!!

#include <stdio.h>

int main(void)
{
    double p;       
    double r;       
    double deposit; 
    double aims;    
    double total; 
    int year = 0; 

    printf("請輸入本金 p: ");
    scanf_s("%lf",&p);
    printf("請輸入年利率 r: ");
    scanf_s("%lf", &r);
    printf("請輸入每年定期存入金額: ");
    scanf_s("%lf", &deposit);
    printf("請輸入存款目標 aims: ");
    scanf_s("%lf", &aims);

    total = p; 

    while (total < aims)
    {
        total = total * (1 + r); 
        total = total + deposit; 
        year++;                  

        printf("第 %d 年的本利合為 %.2lf\n", year, total);
    }

    printf("共需 %d 年才能達成目標 %.2lf 元\n", year, aims);

    return 0;
}
