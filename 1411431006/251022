// 題目一、從鍵盤輸入本金(p=10000) 年利率(r=0.05)，
// 以及存款目標(aims)印出每年底(複利)本利合，
// 直到達成存款目標，讓使用者知道幾年才能達成目標。
// 注意! 計算次方項時，不得使用庫存函數pow( , )!!!!

#include <stdio.h>

int main(void)
{
    double p; 
    double r;     
    double aims;  
    double total; 
    int year = 0; 

    printf("請輸入本金 p: ");
    scanf_s("%lf", &p);
    printf("請輸入年利率 r: ");
    scanf_s("%lf", &r);
    printf("請輸入存款目標 aims: ");
    scanf_s("%lf", &aims);

    total = p; 
  
    while (total < aims)
    {
        total = total * (1 + r); 
        year++;
        printf("第 %d 年的本利合為 %.2lf\n", year, total);
    }

    printf("共需 %d 年才能達成目標 %.2lf 元\n", year, aims);

    return 0;
}

// 題目二、從鍵盤輸入本金(p=10000) 年利率(r=0.05)，
// 每個年底定期定額存入金額，以及存款目標(aims)印出每年底(複利)本利合，
// 直到達成存款目標，讓使用者知道幾年才能達成目標。
// 注意! 計算次方項時，不得使用庫存函數pow( , )!!!!

#include <stdio.h>

int main(void)
{
    double p;       
    double r;       
    double deposit; 
    double aims;    
    double total; 
    int year = 0; 

    printf("請輸入本金 p: ");
    scanf_s("%lf",&p);
    printf("請輸入年利率 r: ");
    scanf_s("%lf", &r);
    printf("請輸入每年定期存入金額: ");
    scanf_s("%lf", &deposit);
    printf("請輸入存款目標 aims: ");
    scanf_s("%lf", &aims);

    total = p; 

    while (total < aims)
    {
        total = total * (1 + r); 
        total = total + deposit; 
        year++;                  

        printf("第 %d 年的本利合為 %.2lf\n", year, total);
    }

    printf("共需 %d 年才能達成目標 %.2lf 元\n", year, aims);

    return 0;
}

// 題目三、利用上一週的第2題，新增一參數x，計算出課本習題3.45(c)的數列值的結果，其中x的次方(冪)項不能用庫存函數pow( )。
// ( E的X次方=1+1!x​+2!x2​+3!x3​+⋯ )

#include <stdio.h>

int main(void)
{
    double x;
    double term = 1.0;
    double sum = 1.0;
    int n, terms;

    printf("請輸入 x 的值: ");
    scanf_s("%lf", &x);
    printf("請輸入要計算的項數: ");
    scanf_s("%d", &terms);

    for (n = 1; n <= terms; n++) {
        term = term * x / n;
        sum = sum + term;
    }

    printf("e 的 %.2lf 次方近似值為: %.10lf\n", x, sum);

    return 0;
}

// 題目四、輸入計算的項目總數n，利用迴圈計算下列級數的結果去近似pi值

#include <stdio.h>

int main(void)
{
    int n, i;             
    double pi = 0.0;      
    double sign = 1.0;  

    printf("請輸入要計算的項數 n: ");
    scanf_s("%d", &n);     

    for (i = 0; i < n; i++) {
        pi += sign * 4.0 / (2 * i + 1); 
        sign = -sign;                  
    }

    printf("近似的 π 值為: %.10lf\n", pi);

    return 0;
}
