/*題目2. 承上題根據fig11_14.c的檔案內容，將剛才建立的隨機存取檔的內容印出，包括每一位學生的平均成績*/

#include <stdio.h>

struct student {
    int id;
    char name[20];
    int computer, math;
    double avg;
};

int main(void) {
    FILE *cfPtr;
    struct student std = {0, "", 0, 0, 0.0};

    if ((cfPtr = fopen("students.dat", "rb")) == NULL) {
        puts("檔案不存在。");
    } else {
        printf("%-6s%-16s%-10s%-10s%-10s\n", "學號", "姓名", "電腦", "數學", "平均");

        while (!feof(cfPtr)) {
            size_t result = fread(&std, sizeof(struct student), 1, cfPtr);

            if (result != 0 && std.id != 0) {
                printf("%-6d%-16s%-10d%-10d%-10.2f\n", 
                       std.id, std.name, std.computer, std.math, std.avg);
            }
        }
        fclose(cfPtr);
    }
    return 0;
}


