/*題目2: 以類別建立成員函數與資料成員，包所需的“set”functions 與 “get”functions，用來設定與取得寵物狗的姓名與年齡(定義為私有資料成員)，透過“set”function判斷資料正確性(輸入姓名長度是否大於2並小於5、年齡是否>20歲)，透過“get”function ，先詢問是否為主人，按Y，則印出寵物的姓名與年齡。*/

#include <iostream>
#include <string>
using namespace std;

class PET {
public:
    void setPetName(string name) {
        if (name.length() > 2 && name.length() < 5) petName = name;
    }
    void setPetAge(int age) {
        if (age > 20) petAge = age;
    }
    string getPetName() const { return petName; }
    int getPetAge() const { return petAge; }

private:
    string petName = "John";
    int petAge = 25;
};

int main() {
    PET myPet;
    char isMaster;

    cout << "請問您是主人嗎？(y/n): ";
    cin >> isMaster;
    cin.ignore(); 

    if (isMaster == 'y' || isMaster == 'Y') {
        cout << "\n[目前資訊] 姓名: " << myPet.getPetName()
            << ", 年齡: " << myPet.getPetAge() << endl;

        string newName;
        int newAge;
        cout << "\n請輸入要修改的新姓名: ";
        getline(cin, newName);
        myPet.setPetName(newName);

        cout << "請輸入要修改的新年齡: ";
        cin >> newAge;
        myPet.setPetAge(newAge);

        cout << "\n[修改後資訊] 姓名: " << myPet.getPetName()
            << ", 年齡: " << myPet.getPetAge() << endl;
    }
    else {
        cout << "抱歉，您無權存取寵物資料。" << endl;
    }

    return 0;
}






