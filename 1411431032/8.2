#include<stdio.h>

int calcyears(float p, float r, float x, float aim);

int main(void) {
	float p, r, x, aim;
	int year;
	printf("本金\n");
	scanf_s("%f", &p);
	printf("年利率\n");
	scanf_s("%f", &r);
	printf("每年存入\n");
	scanf_s("%f", &x);
	printf("目標\n");
	scanf_s("%f", &aim);
	year = calcyears(p, r, x, aim);
	printf("需要%d年", year);
}
int calcyears(float p, float r, float x, float aim) {
	float total = p;
	int year=0;
	while (total < aim) {
		total = total * (1 + r) + x;
		year ++;
		printf("第%d年本利合%.2f\n",year,total);
	}
	return year;
}
