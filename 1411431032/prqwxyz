// Addition program.
#include <stdio.h>

// function main begins program execution
int main(void)
{
	int p,r,q,w,x,y,z ;

	printf("Enter integer p \n"); // prompt
	scanf_s("%d", &p);
	printf("Enter integer r \n"); // prompt
	scanf_s("%d", &r);
	printf("Enter integer q \n"); // prompt
	scanf_s("%d", &q);
	printf("Enter integer w \n"); // prompt
	scanf_s("%d", &w);
	printf("Enter integer x \n"); // prompt
	scanf_s("%d", &x);
	printf("Enter integer y \n"); // prompt
	scanf_s("%d", &y);
	z = p * r % q + w / x - y ; // assign total to sum

	printf(" %d * %d %% %d + %d / %d - %d = %d", p, r, q, w , x , y , z );
	return 0;
}
