//001
//main
#include <iostream>
#include <iomanip>
#include "Shape.h"

using namespace std;

int main() {
   
    cout << fixed << setprecision(2);

   
    Shap* a1 = nullptr;

    // 建立各個衍生類別的物件
    Cone myCone(3.0, 10.0);         // 半徑3, 高10
    Sphere mySphere(5.0);           // 半徑5
    Cylinder myCylinder(3.0, 10.0); // 半徑3, 高10

    cout << "===== 多型體積計算結果 =====" << endl;

    // --- 指向圓錐體 ---
    a1 = &myCone;
    cout << "圓錐體體積: " << a1->Volume() << endl;

    // --- 指向球體 ---
    a1 = &mySphere;
    cout << "球體體積: " << a1->Volume() << endl;

    // --- 指向圓柱體 ---
    a1 = &myCylinder;
    cout << "圓柱體體積: " << a1->Volume() << endl;

    return 0;
}
//介面
#ifndef SHAP_H
#define SHAP_H


class Shap {
public:
    // 純虛擬函數，使此類別成為抽象類別
    virtual double Volume() const = 0;

    // 虛擬解構子
    virtual ~Shap() {}
};

// 2. 衍生類別：圓錐體體積 (Cone)
class Cone : public Shap {
public:
    Cone(double r, double h);
    virtual double Volume() const override;
private:
    double radius;
    double height;
};

// 3. 衍生類別：球體體積 (Sphere)
class Sphere : public Shap {
public:
    Sphere(double r);
    virtual double Volume() const override;
private:
    double radius;
};

// 4. 衍生類別：圓柱體體積 (Cylinder)
class Cylinder : public Shap {
public:
    Cylinder(double r, double h);
    virtual double Volume() const override;
private:
    double radius;
    double height;
};

#endif
//實作
#include <cmath>
#include "Shape.h"

const double PI = 3.14159; // 定義常數 PI [15.4, 369]

// --- Cone 實作 ---
Cone::Cone(double r, double h) : radius(r), height(h) {}
double Cone::Volume() const {
    return (1.0 / 3.0) * PI * std::pow(radius, 2) * height;
}

// --- Sphere 實作 ---
Sphere::Sphere(double r) : radius(r) {}
double Sphere::Volume() const {
    return (4.0 / 3.0) * PI * std::pow(radius, 3);
}

// --- Cylinder 實作 ---
Cylinder::Cylinder(double r, double h) : radius(r), height(h) {}
double Cylinder::Volume() const {
    return PI * std::pow(radius, 2) * height;
}
