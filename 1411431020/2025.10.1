#include <stdio.h>

// function main begins program execution 
int main(void)
{
	int z, p,r, q, w, x, y;

	printf("z = pr mod q + w/x - y\n"); // prompt
	printf("Enter p integer\n"); // prompt
	scanf_s("%d", &p);
	printf("Enter r integer\n"); // prompt
	scanf_s("%d", &r);
	printf("Enter q integer\n"); // prompt
	scanf_s("%d", &q);
	printf("Enter w integer\n"); // prompt
	scanf_s("%d", &w);
	printf("Enter x integer\n"); // prompt
	scanf_s("%d", &x);
	printf("Enter y integer\n"); // prompt
	scanf_s("%d", &y);

	//sum = integer1 + integer2; // assign total to sum
	z = p * r % q + w / x - y;
	// A=B 是指將B內容搬到A裡面


	printf("z = p * r mod q + w/x - y \n  = %d * %d mod %d + %d / %d - %d\nand the z is %d\n", p, r, q, w, x, y, z);
	return 1;
}

