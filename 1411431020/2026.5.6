    cout << "請輸入矩陣列數 (row): ";
    cin >> r;
    cout << "請輸入矩陣行數 (column): ";
    cin >> c;

    Matrix a(r, c);

    cout << "請輸入矩陣元素內容：" << endl;
    for (int i = 0; i < r; ++i) {
