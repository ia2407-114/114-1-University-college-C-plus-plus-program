//main
#include <iostream>
#include "Matrix.h"
using namespace std;

int main() {
    int r, c;
    cout << "--- 矩陣減法運算子 (-) 測試 ---" << endl;
    cout << "輸入矩陣的列數 (row): "; cin >> r;
    cout << "輸入矩陣的行數 (column): "; cin >> c;

    // 建立兩個矩陣物件
    Matrix a(r, c);
    Matrix b(r, c);

    cout << "\n請輸入矩陣 A 的內容：" << endl;
    for (int i = 0; i < r; ++i) {
        for (int j = 0; j < c; ++j) {
            double val;
            cout << "A[" << i << "][" << j << "]="; cin >> val;
            a.setElement(i, j, val);
        }
    }

    cout << "\n請輸入矩陣 B 的內容：" << endl;
    for (int i = 0; i < r; ++i) {
        for (int j = 0; j < c; ++j) {
            double val;
            cout << "B[" << i << "][" << j << "]="; cin >> val;
            b.setElement(i, j, val);
        }
    }

    // 呼叫二元運算子多載
    a - b;

    return 0;
}

//介面p
#ifndef MATRIX_H
#define MATRIX_H

class Matrix {
public:
    // 建構子與解構子 
    Matrix(int r, int c);
    ~Matrix();

    // 題目要求：二元運算子多載 (a - b)
    // 用途：將矩陣 a 減去矩陣 b 並印出結果
    void operator-(const Matrix& other) const;

    // 設定矩陣元素功能
    void setElement(int i, int j, double value);

private:
    int row;
    int column;
    double** element; 
};

#endif

//實作cpp
#include <iostream>
#include <iomanip>
#include "Matrix.h"
using namespace std;

// 建構子：執行動態記憶體配置
Matrix::Matrix(int r, int c) : row(r), column(c) {
    element = new double* [row];
    for (int i = 0; i < row; ++i) {
        element[i] = new double[column];
    }
}

// 解構子：釋放動態配置的記憶體 
Matrix::~Matrix() {
    for (int i = 0; i < row; ++i) {
        delete[] element[i];
    }
    delete[] element;
}

void Matrix::setElement(int i, int j, double value) {
    if (i >= 0 && i < row && j >= 0 && j < column) {
        element[i][j] = value;
    }
}

// 實作二元運算子 
void Matrix::operator-(const Matrix& other) const {
    // 檢查兩矩陣維度是否相同 (基礎驗證)
    if (this->row != other.row || this->column != other.column) {
        cout << "錯誤：矩陣維度不符，無法相減！" << endl;
        return;
    }

    cout << "\n執行[矩陣 A] - [矩陣 B] 的結果如下：" << endl;
    for (int i = 0; i < row; ++i) {
        for (int j = 0; j < column; ++j) {
            // 執行減法運算並印出結果
            double result = this->element[i][j] - other.element[i][j];
            cout << fixed << setprecision(2) << result << "\t";
        }
        cout << endl;
    }
}
