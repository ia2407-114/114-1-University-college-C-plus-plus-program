//介面p
#ifndef MATRIX_H
#define MATRIX_H

class Matrix {
public:
    // 建構子與解構子 
    Matrix(int r, int c);
    ~Matrix();

    // 題目1：前序運算子 (!a)，印出平方根
    void operator!() const;

    // 題目2要求：後序一元運算子多載 (a++)
    // 注意：參數列中的 int 是為了與前序區分之語法規範 
    void operator++(int);

    // 設定矩陣元素功能
    void setElement(int i, int j, double value);

private:
    int row;
    int column;
    double** element; // 使用 double 型態 
};

#endif

//實作cpp
#include <iostream>
#include <iomanip>
#include <cmath> // 用於 pow 函式 
#include "Matrix.h"
using namespace std;

// 建構子：動態配置二維陣列 
Matrix::Matrix(int r, int c) : row(r), column(c) {
    element = new double* [row];
    for (int i = 0; i < row; ++i) {
        element[i] = new double[column];
    }
}

// 解構子：釋放記憶體 
Matrix::~Matrix() {
    for (int i = 0; i < row; ++i) {
        delete[] element[i];
    }
    delete[] element;
}

void Matrix::setElement(int i, int j, double value) {
    if (i >= 0 && i < row && j >= 0 && j < column) {
        element[i][j] = value;
    }
}

// 實作題目1：!a (平方根結果)
void Matrix::operator!() const {
    cout << "\n[執行 !a] 矩陣各元素之平方根結果：" << endl;
    for (int i = 0; i < row; ++i) {
        for (int j = 0; j < column; ++j) {
            cout << fixed << setprecision(2) << sqrt(element[i][j]) << "\t";
        }
        cout << endl;
    }
}

// 實作題目2：a++ (2 次方結果)
void Matrix::operator++(int) {
    cout << "\n[執行 a++] 矩陣各元素之 2 次方 (平方) 結果：" << endl;
    for (int i = 0; i < row; ++i) {
        for (int j = 0; j < column; ++j) {
            // 使用 pow(x, 2) 或直接 element[i][j] * element[i][j] [145, p.192]
            double result = pow(element[i][j], 2.0);
            cout << fixed << setprecision(2) << result << "\t";
        }
        cout << endl;
    }
}


