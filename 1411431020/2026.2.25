//Dev-c++
//001
#include <stdio.h>

int main(void)
{
    FILE* cfPtr; // cfPtr = clients.txt file pointer   

    // fopen opens file. Exit program if unable to create file 
    if ((cfPtr = fopen("clients.txt", "w")) == NULL) {
        puts("File could not be opened");
    }
    else {
        puts("Enter the id, name, computer score, math score.");
        puts("Enter EOF to end input.");
        printf("%s", "? ");

        unsigned int id; // account number
        char name[30];
        int computer, math;// account name
        double avg; // account balance

        scanf("%d %29s %3d %3d", &id, name, &computer, &math);
        avg = ((float)computer + math) / 2;

        // write account, name and balance into file with fprintf
        while (!feof(stdin)) {
            fprintf(cfPtr, "%d %s %3d %3d %.2f\n", id, name, computer, math, avg);
            printf("%s", "? ");
            scanf("%d %29s %3d %3d", &id, name, &computer, &math);
        }

        fclose(cfPtr); // fclose closes file   
    }
}



//002
#include <stdio.h>

// clientData structure definition            
struct student {
    int id;
    char name[20];
    int computer, math;
    double avg;
};

int main(void)
{
    FILE* cfPtr; // accounts.dat file pointer

    // fopen opens the file; exits if file cannot be opened
    if ((cfPtr = fopen("accounts.dat", "wb")) == NULL) {
        puts("File could not be opened.");
    }
    else {
        // create clientData with default information       
        struct student blankstudent = { 0, "", 0, 0, 0.0 };

        // output 100 blank records to file                              
        for (unsigned int i = 1; i <= 100; ++i) {
            fwrite(&blankstudent, sizeof(struct student), 1, cfPtr);
        }

        fclose(cfPtr); // fclose closes the file
    }
}
