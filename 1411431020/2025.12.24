#include <stdio.h>
#define SIZE 10
#define COLS 3
#define STR_LEN 20

// 1. 函數原型宣告
void bubbleSort(int(*data)[COLS], float* avg, char** names, int size);
void swapInt(int* a, int* b);
void swapFloat(float* a, float* b);
void copy2(char* s1, const char* s2); // 參考 p.333 Fig. 7.21

int main(void) {
    // 2. 初始化資料 (學號, 數學, 計概)
    int studentData[SIZE][COLS] = {
        {101, 85, 90}, {102, 70, 80}, {103, 92, 88}, {104, 60, 70}, {105, 75, 82},
        {106, 95, 91}, {107, 88, 85}, {108, 50, 65}, {109, 82, 80}, {110, 77, 79}
    };

    // 為了使用 copy2 交換內容，姓名需存於可改寫的空間
    char nameData[SIZE][STR_LEN] = {
        "Alice", "Bob", "Charlie", "David", "Eve",
        "Frank", "Grace", "Heidi", "Ivan", "Judy"
    };

    // 建立指標陣列指向姓名資料 [1]
    char* name[SIZE] = {};
    for (int i = 0; i < SIZE; ++i) {
        *(name + i) = *(nameData + i); // 指標位移標記法
    }

    float averages[SIZE] = {};

    // 3. 主程式計算平均成績 [2]
    for (int i = 0; i < SIZE; ++i) {
        // 使用指標位移標記法存取元素 *(ptr + i) [1]
        float total = (float)(*(*(studentData + i) + 1) + *(*(studentData + i) + 2));
        *(averages + i) = total / 2.0f;
    }

    // 4. 呼叫排序副程式 (傳入指標陣列與資料陣列) [3]
    bubbleSort(studentData, averages, name, SIZE);

    // 5. 印出排序後結果
    printf("%-10s %-10s %-8s %-8s %-8s\n", "姓名", "學號", "數學", "計概", "平均");
    for (int i = 0; i < SIZE; ++i) {
        printf("%-10s %-10d %-8d %-8d %-8.2f\n",
            *(name + i), *(*(studentData + i) + 0),
            *(*(studentData + i) + 1), *(*(studentData + i) + 2), *(averages + i));
    }

    return 0;
}

// ------------------- 副程式定義 -------------------

// 參考 p.333 Fig. 7.21 的字串拷貝副程式 (使用指標方式) [1]
void copy2(char* s1, const char* s2) {
    for (; (*s1 = *s2) != '\0'; ++s1, ++s2) {
        ; // 空陳述
    }
}

// 排序副程式：根據平均分數「由大到小」排序
void bubbleSort(int(*data)[COLS], float* avg, char** names, int size) {
    char tempStr[STR_LEN];

    for (int pass = 1; pass < size; ++pass) {
        for (int i = 0; i < size - pass; ++i) {
            // 比較相鄰平均分數 (由大到小)
            if (*(avg + i) < *(avg + i + 1)) {

                // 1. 交換平均分數 (傳址呼叫) [3]
                swapFloat(avg + i, avg + i + 1);

                // 2. 同步交換整數資料 (學號、數學、計概)
                for (int j = 0; j < COLS; ++j) {
                    swapInt(*(data + i) + j, *(data + i + 1) + j);
                }

                // 3. 字串交換：必須使用 p.333 的拷貝副程式完成
                copy2(tempStr, *(names + i));
                copy2(*(names + i), *(names + i + 1));
                copy2(*(names + i + 1), tempStr);
            }
        }
    }
}

// 整數交換副程式 (傳址呼叫) [3]
void swapInt(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// 浮點數交換副程式 (傳址呼叫) [3]
void swapFloat(float* a, float* b) {
    float temp = *a;
    *a = *b;
    *b = temp;
}
