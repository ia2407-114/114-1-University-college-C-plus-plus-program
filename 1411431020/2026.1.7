    int id, computer, math;
    double average;
};



void sort_array(struct STUDENT MYstu[SIZE], int n) {
    int i, j, temp;
    float temp1;
    char temp_name[SIZE];
    struct STUDENT temp_struct;

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            if (MYstu[j].average < MYstu[j+1].average) {

                temp_struct = MYstu[j];
                MYstu[j] = MYstu[j + 1];
                MYstu[j + 1] = temp_struct;




            }
        }
    }
}




