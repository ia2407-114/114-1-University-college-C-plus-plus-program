int binarySearch(const struct STUDENT arr[], int key)
{
    int low = 0, high = SIZE - 1;
    while (low <= high) {
        int mid = (low + high) / 2;

        if (arr[mid] == key)
            return mid;
        else if (key < arr[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }
    return 0;
}
