//002.cpp
#include <iostream>
#include <stdexcept> // 為了使用 invalid_argument [15]
#include "Dog.h"

using namespace std;

// 建構子實作：直接設定屬性並呼叫驗證 [3, 6]
Dog::Dog(string name, Date birth, Date adopt) {
    petName = name;
    validateData(birth, adopt); // 3. 判斷資料是否合理
    birthday = birth;
    adoptionDate = adopt;
}

void Dog::validateData(Date birth, Date adopt) {
    int age = calculateAge(birth);

    // 驗證年齡：介於 0~20 歲 [16]
    if (age < 0 || age > 20) {
        throw invalid_argument("錯誤：狗的年齡不合理 (需在 0-20 歲之間)。");
    }

    // 驗證領養日：不可早於生日
    if (adopt.year < birth.year ||
        (adopt.year == birth.year && adopt.month < birth.month) ||
        (adopt.year == birth.year && adopt.month == birth.month && adopt.day < birth.day)) {
        throw invalid_argument("錯誤：領養日期不可早於出生日期。");
    }
}

// 以 2026/04/08 為基準計算年齡
int Dog::calculateAge(Date birth) const {
    int currY = 2026, currM = 4, currD = 8;
    int age = currY - birth.year;
    if (birth.month > currM || (birth.month == currM && birth.day > currD)) {
        age--;
    }
    return age;
}

void Dog::displayDogInfo() const {
    cout << "\n--- 寵物狗詳細資訊 ---" << endl;
    cout << "姓名: " << petName << endl;
    cout << "生日: " << birthday.year << "/" << birthday.month << "/" << birthday.day << endl;
    cout << "領養日: " << adoptionDate.year << "/" << adoptionDate.month << "/" << adoptionDate.day << endl;
    cout << "目前年齡: " << calculateAge(birthday) << " 歲" << endl;
}

