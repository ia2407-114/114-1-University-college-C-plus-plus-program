//002.h
#ifndef DOG_H
#define DOG_H

#include <string>

// 定義日期結構
struct Date {
    int year;
    int month;
    int day;
};

class Dog {
public:
    // 2. 建構子：包含姓名、生日及領養日參數 [10, 11]
    Dog(std::string name, Date birth, Date adopt);

    void displayDogInfo() const; // 顯示寵物資訊

private:
    std::string petName;
    Date birthday;
