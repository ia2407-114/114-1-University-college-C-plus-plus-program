//第一題
#include <stdio.h>
#include <math.h> 


double series_e(double);


int main() {
    double x;

    printf("請輸入 x 的值:\n");
    scanf_s("%lf", &x); 

    //無窮級數計算
    double series_result = series_e(x);
    //庫存函數exp計算
    double exp_result = exp(x);
    //誤差
    double error = series_result - exp_result;

    printf("計算 e^%.1f 的結果 \n", x);
    // e^%.2f = e 的x 次方(x 為%.2f 格式)
    printf("無窮級數(series_e): %.15f\n", series_result);
    printf("庫存函數(exp): %.15f\n", exp_result);
    printf("誤差 : %.15e\n", error);

    return 0;
}

double series_e(double x) {
    double sum = 0.0;
    double term = 1.0;
    int n = 0;


    while (fabs(term) > 1e-15) {
        sum += term;
        n++;
        term = term * x / n;
    }

    return sum;
}



//第二題
#include<stdio.h>

float BMI(float weight_In_Kilograms, float height_In_Meters);

int main(void)
{
	float BMI_result, weight_In_Kilograms, height_In_Meters;

	printf("Enter your weight in Kilograms :\n");
	scanf_s("%f", &weight_In_Kilograms);
	printf("Enter your height in Meters :\n");
	scanf_s("%f", &height_In_Meters);

	BMI_result = BMI(weight_In_Kilograms, height_In_Meters);

	printf("Your BMI is %.1f\n", BMI_result);

	if (BMI_result < 18.5) {
		printf("You are Underweight\n");
	}
	//BMI如果不符合<18.5則繼續下一則條，能繼續就表示表示數值>=18.5
	else if (BMI_result < 25) {
		printf("You are Normal\n");
	}
	//BMI=介於18.5及24.9(含)。而數值<25不包含25,能進行此else IF條件判別就表示數值不符合上一個判斷，所以數值>=18.5，結合本次的條件 <25就能得出範圍
	else if (BMI_result < 30) {
		printf("You are Overweight\n");
	}
	else {
		printf("Your are Obese\n");
	}
	return 0;
}

float BMI(float weight_In_Kilograms, float height_In_Meters) {
	return (weight_In_Kilograms / (height_In_Meters * height_In_Meters));
}



//第三題

#include <stdio.h>

double approximate_pi(int n);

int main()
{
	int n;
	double pi_result;

	printf("輸入要計算的項目總數n:");
	scanf_s("%d", &n);

	pi_result = approximate_pi(n);
	printf("使用 %d 個項次計算出的近似值為:%.15f\n", n, pi_result);

	return 0;
}


double approximate_pi(int n)
{
	int i;
	double pi_approx = 0.0;
	double sign = 1.0;

	for (i = 0; i < n; i++)
	{
		double denominator = 2.0 * i + 1.0;
		pi_approx += sign * (4.0 / denominator);
		sign * -1.0;
	}

	return pi_approx;
}
