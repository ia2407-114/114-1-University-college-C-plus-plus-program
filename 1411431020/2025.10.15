int n;
int i;
float exp = 1;
int result =1;
printf("求e的近似值，請輸入階層數n=");
scanf_s(" %d", &n);
for (i = 1;i <= n;i++)
{
result = result * i;
exp = exp + 1.0 / result;
}
printf("顯示e的近似值%f", exp);


}
