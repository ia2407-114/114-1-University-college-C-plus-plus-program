#include <stdio.h>


int main(void)
{
	unsigned int i = 1, fact = 0;
	int result = 1, exp = 1;
	printf("%s", "請輸入一個整數:\n");
	scanf_s("%d", &fact);
	for (i = 1;i <= fact; i++)
	{
		result *= i;
		exp = exp + (float)1 / result;
	}

	
	printf_s("%d的階乘結果為:%d\n", fact, result);
	printf_s("e的結果為:%d", exp);
	// end function main
	return 0;
}




