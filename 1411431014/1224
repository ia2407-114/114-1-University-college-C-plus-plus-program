void copy1(char* s1, const char* s2)
{
    for (; ((*s1 = *s2) != '\0'); ++s1, ++s2);
}

void swap_int(int* prt1, int* prt2) {
    int hold = *prt1;
    *prt1 = *prt2;
    *prt2 = hold;
}

void swap_float(float* prt1, float* prt2) {
    float hold = *prt1;
    *prt1 = *prt2;
    *prt2 = hold;
}
void sort_array(char name[][20], int stu[][SIZE], float avg[], int n) {
    int i, j,k, temp;
    float temp1;
    char temp_name[20];

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            if (avg[j] < avg[j + 1]) {

                copy1(temp_name, name[j]);
                copy1(name[j], name[j + 1]);
                copy1(name[j + 1], temp_name);

                for (k = 0;k <= 2;++k)
                    swap_int(&stu[k][j], &stu[k][j + 1]);
                swap_float(&avg[j], &avg[j + 1]);
            }
        }
    }
}
