#include <stdio.h>
#define SIZE 10

int main(void) {
    int id[SIZE] = { 12, 13, 14, 15, 16, 17, 19, 21, 22, 23 };
    int score[SIZE] = { 66, 67, 66, 70, 73, 74, 75, 75, 62, 32 };

    int i, j;
    int temp_score;
    int temp_id;

    printf("--- 原始資料 ---\n");
    printf("%-8s%s\n", "學號", "成績");
    for (i = 0; i < SIZE; ++i) {
        printf("%-8d%d\n", id[i], score[i]);
    }
    printf("\n");

    for (i = 0; i < SIZE - 1; ++i) {
        for (j = 0; j < SIZE - 1 - i; ++j) {
            if (score[j] > score[j + 1]) {

                temp_score = score[j];
                score[j] = score[j + 1];
                score[j + 1] = temp_score;

                temp_id = id[j];
                id[j] = id[j + 1];
                id[j + 1] = temp_id;
            }
        }
    }

    printf("--- 排序後結果 (成績由小到大) ---\n");
    printf("%-8s%s\n", "學號", "成績");
    for (i = 0; i < SIZE; ++i) {
        printf("%-8d%d\n", id[i], score[i]);
    }

    return 0;
}
