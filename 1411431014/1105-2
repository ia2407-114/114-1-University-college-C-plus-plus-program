#include <stdio.h>
int calcyears(double principal, double rate, double deposit, double aims);

int main(void) {
    double principal, rate, deposit, aims;
    int years;
    printf("請輸入本金：");
    scanf_s("%lf", &principal);
    printf("請輸入年利率(以小數表示)：");
    scanf_s("%lf", &rate);
    printf("請輸入每年定期定額存入金額：");
    scanf_s("%lf", &deposit);
    printf("請輸入存款目標金額：");
    scanf_s("%lf", &aims);
    years = calcyears(principal, rate, deposit, aims);
    printf("共需%d年才能達成目標金額。\n", years);
}

int calcyears(double principal, double rate, double deposit, double aims) {
    double total = principal;
    int year = 0;
    while (total < aims) {
        total *= (1 + rate);
        total += deposit;
        year++;
        printf("第%d年本利合為：%.2f\n", year, total);
    }

    return year;
}
