#include <stdio.h>

int main(void)
{
	int counter = 0;
	int grade;
	int total = 0;
	int pass_count = 0;
	int fail_count = 0;
	float average;

	printf("%s", "Enter grade, -1 to end: ");
	scanf_s("%d", &grade);


	while (grade >= 0) {
		total = total + grade;
		counter = counter + 1;
		if (grade >= 60) {
			pass_count = pass_count + 1;
		}
		else {
			fail_count = fail_count + 1;
		}
		printf("%s", "Enter grade, -1 to end: ");
		scanf_s("%d", &grade);
	}

	if (counter > 0) {
		average = (float)total / counter;

		printf("\n統計結果\n");
		printf("及格人數: %d\n", pass_count);
		printf("不及格人數: %d\n", fail_count);
		printf("平均成績: %.1f\n", average);

		if ((float)pass_count / counter >= 0.5) {
			printf("Bouns to the Teacher!\n");
		}
	}

	else {
		puts("No grades were entered");
	}
	return 0;
}
