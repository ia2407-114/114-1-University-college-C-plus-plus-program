//CinemaManager.cpp
#include "CinemaManager.h"
#include <iostream>
#include <fstream>
#include <cstdlib>

using namespace std;

void writeMovieData(const string& filename, int count) {
    ofstream writebinaryfile;
    writebinaryfile.open(filename, ios_base::out | ios_base::binary);

    if (writebinaryfile.fail()) {
        cout << filename << " 檔案無法開啟!\n";
        exit(1);
    }

    struct cinema movie;
    cout << "--- 建立電影資訊 (共 " << count << " 筆) ---\n";
    for (int i = 0; i < count; ++i) {
        cout << "\n[第 " << i + 1 << " 筆]";
        cout << "\n電影名稱: ";
        cin >> movie.name;
        cout << "上映日期: ";
        cin >> movie.date;
        cout << "上映廳處: ";
        cin >> movie.place;
        cout << "票價: ";
        cin >> movie.price;

        writebinaryfile.write((char*)&movie, sizeof(struct cinema));
    }

    writebinaryfile.close();
    if (writebinaryfile.fail()) {
        cout << filename << " 檔案無法關閉!\n";
        exit(1);
    }
    cout << "\n資料寫入完畢。\n\n";
}

void displayAllMovieNames(const string& filename) {
    ifstream readbinaryfile;
    readbinaryfile.open(filename, ios_base::in | ios_base::binary);

    if (readbinaryfile.fail()) {
        cout << filename << " 檔案無法開啟!\n";
        exit(1);
    }

    struct cinema movie;
    int i = 1;
    cout << "--- 電影清單 ---\n";

    while (true) {
        readbinaryfile.read((char*)&movie, sizeof(struct cinema));

        if (!readbinaryfile.eof()) {
            cout << i << ". 電影名稱: " << movie.name << '\n';
        }
        else {
            break;
        }
        i++;
    }

    readbinaryfile.clear();
    readbinaryfile.close();
}

void displayMovieDetail(const string& filename, int index) {
    ifstream readbinaryfile;
    readbinaryfile.open(filename, ios_base::in | ios_base::binary);

    if (readbinaryfile.fail()) {
        cout << filename << " 檔案無法開啟!\n";
        exit(1);
    }

    struct cinema movie;

    readbinaryfile.seekg(sizeof(struct cinema) * (index - 1), ios::beg);
    readbinaryfile.read((char*)&movie, sizeof(struct cinema));

    if (!readbinaryfile.eof()) {
        cout << "\n=== 第 " << index << " 筆電影詳細資料 ===\n";
        cout << "電影名稱: " << movie.name << '\t'
            << "上映日期: " << movie.date << '\n'
            << "上映廳處: " << movie.place << '\t'
            << "票價: " << movie.price << '\n';
    }
    else {
        cout << "\n錯誤：查無此電影資料（索引超出範圍）。\n";
    }

    readbinaryfile.clear();
    readbinaryfile.close();
}

