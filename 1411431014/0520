//ShapeClasses.cpp
#include "ShapeClasses.h"
#include <iostream>

using namespace std;

shape::shape(string n) : name(n), shape_area(0) {}

void shape::area() {
    cout << name << "的計算結果為: " << shape_area << endl;
}

rectangle::rectangle() : shape("長方形"), length(0), width(0) {}

void rectangle::data_input() {
    cout << "請輸入長方形的長: ";
    cin >> length;
    cout << "請輸入長方形的寬: ";
    cin >> width;
}

cube::cube() : height(0) {
    name = "長方體體積"; 
}

void cube::data_input() {
    rectangle::data_input();

    cout << "請輸入長方體的高: ";
    cin >> height;

    shape_area = length * width * height;
}

//ShapeClasses.h
#pragma once
#ifndef SHAPE_CLASSES_H
#define SHAPE_CLASSES_H
#include <string>

class shape {
protected:
    std::string name;
    double shape_area;

public:
    shape(std::string n = "未知圖形");
    void area();
};

class rectangle : public shape {
protected:
    double length;
    double width;

public:
    rectangle();
    void data_input();
};

class cube : public rectangle {
private:
    double height;

public:
    cube();
    void data_input(); 
};

#endif
