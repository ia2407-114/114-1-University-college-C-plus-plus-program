//date.cpp
#include <iostream>
#include <iomanip>
#include <stdexcept>
#include "date.h" 
using namespace std;

Date::Date(int year, int month, int day)
{
    setDate(year, month, day); 
} 

void Date::setDate(int y, int m, int d)
{
    setYear(y); 
    setMonth(m); 
    setDay(d); 
} 

void Date::setYear(int y)
{
    if (y >= 1 && y < 9999)
        year = y;
    else
        cout << "year must be 0-9999";
}

void Date::setMonth(int m)
{
    if (m > 0 && m < 13)
        month = m;
    else
        cout << "month must be 1-12";
} 

void Date::setDay(int d)
{
    if (d > 0 && d < 32)
        day = d;
    else
        cout << "day must be 1-31";
} 

unsigned int Date::getYear() const
{
    return year;
} 

unsigned int Date::getMonth() const
{
    return month;
} 

unsigned int Date::getDay() const
{
    return day;
} 

void Date::printUniversal() const
{
    cout << "  西元" << setfill('0') << setw(2) << getYear() << "/"
        << setw(2) << getMonth() << "/" << setw(2) << getDay();
} 

void Date::printStandard() const
{
    cout << (year < 1911 ? "民國前 " : "民國 ") << ((getYear() > 1911 ? year - 1911 : 1911 - year))
        << "/" << setfill('0') << setw(2) << getMonth()
        << "/" << setw(2) << getDay();
} 

//date.h
#ifndef DATE_H
#define DATE_H

class Date
{
public:
	explicit Date(int = 1900, int = 1, int = 1); 

	void setDate(int, int, int); 
	void setYear(int); 
	void setMonth(int); 
	void setDay(int); 

	unsigned int getYear() const; 
	unsigned int getMonth() const;
	unsigned int getDay() const; 

	void printUniversal() const; 
	void printStandard() const; 
private:
	unsigned int year; 
	unsigned int month; 
	unsigned int day; 
}; 

#endif

//pet.cpp
#include <iostream>
#include "PET.h" 
#include "Date.h" 
using namespace std;

void printDate(const PET& p) {
    cout << "--- 透過 Friend Function 印出日期 ---" << endl;
    cout << p.firstName << " 的生日: ";
    p.birthDate.printStandard(); 
    cout << "\n" << p.firstName << " 的領養日: ";
    p.adoptDate.printStandard();
    cout << "\n------------------------------------" << endl;
}

PET::PET(const string& first, const string& last,
    const Date& dateOfBirth, const Date& dateOfHire)
    : firstName(first), 
    category(last), 
    birthDate(dateOfBirth), 
    adoptDate(dateOfHire) 
{
    cout << "PET object constructor: "
        << firstName << ' ' << category << endl;
} 


void PET::print() const
{
    cout << category << ", " << firstName << "  Adopted: ";
    adoptDate.printStandard();
    adoptDate.printUniversal();
    cout << "  Birthday: ";
    birthDate.printStandard();
    birthDate.printUniversal();
    cout << endl;
} 


PET::~PET()
{
    print();
    cout << "\n PET object destructor: "
        << category << ", " << firstName << endl;
} 

//pet.h
#pragma once
#ifndef PET_H
#define PET_H
#include <string>
#include "Date.h" 

class PET
{
    friend void printDate(const PET&);
public:
    PET(const std::string&, const std::string&,
        const Date&, const Date&);
    void print() const;
    ~PET(); 
private:
    std::string firstName; 
    std::string category; 
    const Date birthDate; 
    const Date adoptDate; 
}; 
#endif
