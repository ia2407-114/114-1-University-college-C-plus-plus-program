//flight.h
#ifndef FLIGHT_H
#define FLIGHT_H

#include <iostream>
#include <string>
using namespace std;

class flight_object {
public:
    string name;
    int id;
    int pilot;
    float kerosene;
    string manufacturer;

    void create_flight_object(string obj);
    virtual void display() = 0;
    virtual ~flight_object() {}
};

class airliner : public virtual flight_object {
protected:
    int passenger;
    int service_person;
public:
    void create_airliner();
    virtual void display() override;
};

class battleplane : public virtual flight_object {
protected:
    string weapon;
public:
    void create_battleplane();
    virtual void display() override;
};

class bombplane : public airliner, public battleplane {
public:
    void create_bombplane();
    virtual void display() override;
};

#endif

//main.cpp
#include "flight.h"

int main() {
    bombplane bomb1;
    bomb1.create_flight_object("轟炸機");
    bomb1.create_bombplane();

    cout << "\n==============================\n";

    flight_object* ptr = &bomb1;
    ptr->display();

    return 0;
}
