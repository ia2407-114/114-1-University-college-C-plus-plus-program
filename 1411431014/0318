#include <iostream>
using namespace std;

int volume(int x)
{
	return x * x * x;
}

double volume(double r, double h)
{
	return r*r* h * 3.14;
}

int volume(int x, int y, int z)
{
	return x * y * z;
}

int main()
{
	int a, b, c;

	cout << "計算正方體體積" << endl;
	cout << "輸入邊長:";
	cin >> a;
	cout << "正方體體積為:" << volume(a) << endl;

	cout << "計算圓柱體積" << endl;
	cout << "輸入半徑與高:";
	cin >> a>>b;
	cout << "圓柱體積為:" << volume(a,b) << endl;

	cout << "計算長方體體積" << endl;
	cout << "輸入長寬高:";
	cin >> a>>b>>c;
	cout << "長方體體積為:" << volume(a,b,c) << endl;

}
