#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct student {
    int id;
    char name[20];
    int computer, math;
    double avg;
    struct student* nextPtr;
};

typedef struct student Student;
typedef Student* StudentPtr;

void insert(StudentPtr* sPtr, int id, char name[], int comp, int math);
int deleteNode(StudentPtr* sPtr, int id); 
void printList(StudentPtr currentPtr);
int isEmpty(StudentPtr sPtr);

int main(void) {
    StudentPtr startPtr = NULL;
    int id, comp, math, choice;
    char name[20];

    printf("1插入  2刪除  3 結束\n");

    while (1) {
        printf("\n請輸入指令 (1/2/3): ");
        if (scanf("%d", &choice) != 1) break;

        if (choice == 3) break;

        switch (choice) {
        case 1:
            printf("輸入學號: ");
            (void)scanf("%d", &id);
            printf("輸入姓名: ");
            (void)scanf("%s", name);
            printf("輸入電腦與數學成績: ");
            (void)scanf("%d %d", &comp, &math);
            insert(&startPtr, id, name, comp, math);
            printList(startPtr);
            break;

        case 2:
            if (isEmpty(startPtr)) {
                printf("串列目前是空的，無法刪除。\n");
            }
            else {
                printf("請輸入欲刪除的學生 ID: ");
                (void)scanf("%d", &id);

                
                if (deleteNode(&startPtr, id)) {
                    printf("學號 %d 的資料已成功刪除。\n", id);
                }
                else {
                    printf("找不到資料 (學號 %d 不存在)。\n", id);
                }
                printList(startPtr);
            }
            break;

        default:
            printf("無效指令，請重新輸入。\n");
            break;
        }
    }

    puts("\n執行結束。");
    return 0;
}


int deleteNode(StudentPtr* sPtr, int id) {
    StudentPtr tempPtr;

    if (id == (*sPtr)->id) {
        tempPtr = *sPtr;          
        *sPtr = (*sPtr)->nextPtr; 
        free(tempPtr);            
        return 1;                 
    }
    else {
        StudentPtr previousPtr = *sPtr;
        StudentPtr currentPtr = (*sPtr)->nextPtr;

        
        while (currentPtr != NULL && currentPtr->id != id) {
            previousPtr = currentPtr;
            currentPtr = currentPtr->nextPtr;
        }

        if (currentPtr != NULL) {
            tempPtr = currentPtr;
            previousPtr->nextPtr = currentPtr->nextPtr; 
            free(tempPtr); 
            return 1;      
        }
    }

    return 0; 
}

void insert(StudentPtr* sPtr, int id, char name[], int comp, int math) {
    StudentPtr newPtr = (StudentPtr)malloc(sizeof(Student));

    if (newPtr != NULL) {
        newPtr->id = id;
        strcpy(newPtr->name, name);
        newPtr->computer = comp;
        newPtr->math = math;
        newPtr->avg = ((double)comp + (double)math) / 2.0;
        newPtr->nextPtr = NULL;

        StudentPtr previousPtr = NULL;
        StudentPtr currentPtr = *sPtr;

        while (currentPtr != NULL && id > currentPtr->id) {
            previousPtr = currentPtr;
            currentPtr = currentPtr->nextPtr;
        }

        if (previousPtr == NULL) {
            newPtr->nextPtr = *sPtr;
            *sPtr = newPtr;
        }
        else {
            previousPtr->nextPtr = newPtr;
            newPtr->nextPtr = currentPtr;
        }
    }
}

void printList(StudentPtr currentPtr) {
    if (currentPtr == NULL) {
        printf("目前的串列內容: (空)\n");
    }
    else {
        printf("\n目前的學生清單:\n");
        printf("%-8s %-12s %-8s %-8s %-8s\n", "ID", "Name", "Comp", "Math", "Avg");
        while (currentPtr != NULL) {
            printf("%-8d %-12s %-8d %-8d %-8.2f\n",
                currentPtr->id, currentPtr->name, currentPtr->computer,
                currentPtr->math, currentPtr->avg);
            currentPtr = currentPtr->nextPtr;
        }
    }
}

int isEmpty(StudentPtr sPtr) {
    return sPtr == NULL;
}
