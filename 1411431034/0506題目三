//主程式
#include <iostream>
#include "Matrix.h"
using namespace std;

int main() {
    int i, j, row, column;
    cout << "減號運算子多載，使其能應用在矩陣減法上\n";
    cout << "輸入矩陣A及B的列數(row):";
    cin >> row;
    cout << "輸入矩陣A及B的行數(column):";
    cin >> column;


    Matrix a('A', row, column);
    Matrix b('B', row, column);
    Matrix c(row, column);

    c = a - b;

    cout << "\n矩陣A - 矩陣B = \n";
    for (i = 0; i < row; i++) {
        for (j = 0; j < column; j++) {
            cout << c.element[i][j] << '\t';
        }
        cout << endl;
    }

    return 0;
}
//實作檔
#include <iostream>
#include "Matrix.h"
using namespace std;


Matrix::Matrix(int m, int n){
    column = n;
    row = m;
    element = new double* [m];
    for (int i = 0; i < m; i++)
        element[i] = new double[n];
}

Matrix::Matrix(char name, int m, int n){
    column = n;
    row = m;
    element = new double* [m];
    int i, j;
    for (i = 0; i < m; i++)
        element[i] = new double[n];

    cout << "輸入" << m << 'x' << n << "矩陣" << name << endl;
    for (i = 0; i < m; i++) {
        for (j = 0; j < n; j++) {
            cout << name << '[' << i << "][" << j << "]=";
            cin >> element[i][j];
        }
    }
}

Matrix Matrix::operator-(Matrix x) {
    Matrix temp(this->row, this->column);
    for (int i = 0; i < this->row; i++) {
        for (int j = 0; j < this->column; j++) {

            temp.element[i][j] = this->element[i][j] - x.element[i][j];
        }
    }
    return temp;
}
//介面檔
#ifndef MATRIX_H
#define MATRIX_H

class Matrix {
public:
    int row, column;
    double** element;

    
    Matrix(int m, int n);
   
    Matrix(char name, int m, int n);

    Matrix operator-(Matrix x);
};

#endif
