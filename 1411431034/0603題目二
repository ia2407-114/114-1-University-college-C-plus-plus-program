#include <iostream>
#include <fstream>  // 引入檔案讀寫
#include "planes.h"
using namespace std;

int main() {
    bombplane bomb1;
    bomb1.create_flight_object("轟炸機");
    bomb1.create_bombplane();

    // 1. 輸出到螢幕上 (不用帶參數，因為預設就是 cout)
    bomb1.display();

    // 2. 宣告輸出檔案串流，並開啟 "bomb.txt"
    ofstream outfile("bomb.txt");
    if (outfile.fail()) {
        cout << "錯誤：無法建立或開啟 bomb.txt 檔案！" << endl;
        return 1;
    }

    // 3. 將資料輸出到檔案 (把剛剛建立好的檔案串流傳進去)
    bomb1.display(outfile);

    // 4. 關閉檔案
    outfile.close();
    cout << "\n[提示] 轟炸機的資料已成功存入 bomb.txt 檔案中！" << endl;

    return 0;
}

