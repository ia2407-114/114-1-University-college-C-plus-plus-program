#include <iostream>
#include <stdio.h>
int main(void)
{
	int integer1, integer2, sum;
	printf("Enter first integer\n");
	scanf_s("%d", &integer1);
	printf("Enter second integer\n");
	scanf_s("%d", &integer2);
	sum = integer1 + integer2;
	printf("%d plus %d and the sum is %d\n", integer1, integer2, sum);
	return 0

}
