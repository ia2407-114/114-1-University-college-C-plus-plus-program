#include <stdio.h>
#define RESPONSES_SIZE 40
#define FREQUENCY_SIZE 11

int main(void)
{
    // frequency[0] 不使用，frequency[1] 到 frequency[10] 用來統計評分
    int frequency[FREQUENCY_SIZE] = { 0 };
    int answer, rating, i, j;

    int responses[RESPONSES_SIZE] = { 1, 2, 6, 4, 8, 5, 9, 7, 8, 10,
    1, 6, 3, 8, 6, 10, 3, 8, 2, 7, 6, 5, 7, 6, 8, 6, 7, 5, 6, 6,
    5, 6, 7, 5, 6, 4, 8, 6, 8, 10 };

    // 1. 計算頻率
    for (answer = 0; answer < RESPONSES_SIZE; ++answer) {
        ++frequency[responses[answer]];
    }

    // 2. 輸出頻率表 (從 1 到 10)
    printf("%s%17s\n", "Rating", "Frequency");
    for (rating = 1; rating < FREQUENCY_SIZE; ++rating) {
        printf("%6d%17d\n", rating, frequency[rating]);
    }

    // 3. 輸出直方圖標題
    printf("\n%s%13s%17s\n", "Rating", "Frequency", "Histogram");

    // 4. 輸出直方圖 (從 1 到 10)
    for (i = 1; i < FREQUENCY_SIZE; ++i) { // i 從 1 開始
        // 關鍵修正: 使用 frequency[i]
        printf("%7d%13d ", i, frequency[i]);
        printf("      ");
        for (j = 1; j <= frequency[i]; ++j) {
            
            printf("%c",'*');
        }

        puts("");
    }

    return 0;
}
