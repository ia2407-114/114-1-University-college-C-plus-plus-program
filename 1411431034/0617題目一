//實作檔

#include <iostream>
#include <fstream>
#include <cstdlib> 
#include "cinema.h" 
using namespace std;

// 實作寫入電影資訊的函式（修改為固定 5 筆）
void writeMovieData()
{
    struct cinema movie;
    ofstream writebinaryfile;

    writebinaryfile.open("movie.bin", ios_base::out | ios_base::binary);
    if (writebinaryfile.fail())
    {
        cout << "movie.bin檔案無法開啟!\n";
        exit(1);
    }

    cout << "請輸入 5 筆電影資訊\n";
    for (int i = 1; i <= 5; i++)
    {
        cout << "\n第" << i << "筆電影:\n";
        cout << "電影名稱: ";
        cin >> movie.name;
        cout << "上映日期: ";
        cin >> movie.date;
        cout << "上映廳處: ";
        cin >> movie.place;
        cout << "票價: ";
        cin >> movie.price;

        // 寫入二進制檔案
        writebinaryfile.write((char*)&movie, sizeof(struct cinema));
    }

    cout << "\n5 筆資料已成功寫入檔案。\n\n";
    writebinaryfile.close();
}

void readMovieData()
{
    struct cinema movie;
    ifstream readbinaryfile;

    readbinaryfile.open("movie.bin", ios_base::in | ios_base::binary);
    if (readbinaryfile.fail())
    {
        cout << "movie.bin檔案無法開啟!\n";
        exit(1);
    }

    cout << "--- 從檔案讀取電影資訊 ---\n";

    // 更安全、標準的二進制檔案讀取寫法
    while (readbinaryfile.read((char*)&movie, sizeof(struct cinema)))
    {
        cout << "電影名稱:" << movie.name << '\t'
            << "上映日期:" << movie.date << '\n'
            << "上映廳處:" << movie.place << '\t'
            << "票價:" << movie.price << "\n\n";
    }

    readbinaryfile.close();
}

//介面檔

#ifndef CINEMA_H
#define CINEMA_H

// 定義cinema結構型態
struct cinema
{
    char name[40];  // 加大長度，避免中文或長片名溢位
    char date[12];  // 存放如 2026-06-17 或 20260617
    char place[20]; // 加大長度，例如 "A廳 13排"
    int price;      // 票價
};

// 宣告功能函式的原型
void writeMovieData();
void readMovieData();

#endif
