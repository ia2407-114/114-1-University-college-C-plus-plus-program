#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct student {
    int id;
    char name[20];
    int computer, math;
    double avg;
    struct student* nextPtr; 
};

typedef struct student Student;
typedef Student* StudentPtr;

void insert(StudentPtr* sPtr, int id, char name[], int comp, int math);
void printList(StudentPtr currentPtr);
int isEmpty(StudentPtr sPtr);

int main(void) {
    StudentPtr startPtr = NULL; 
    int id, comp, math;
    char name[20];    

    while (1) {
        printf("\n輸入學生學號 (輸入 -1 結束): ");
        scanf_s("%d", &id);
        if (id == -1) break;

        printf("輸入姓名: ");
        scanf_s("%s", name, (unsigned int)sizeof(name));
        printf("輸入電腦成績: ");
        scanf_s("%d", &comp);
        printf("輸入數學成績: ");
        scanf_s("%d", &math);
               
        insert(&startPtr, id, name, comp, math);
               
        printList(startPtr);
    }

    puts("\n執行結束。");
    return 0;
}

void insert(StudentPtr* sPtr, int id, char name[], int comp, int math) {
    StudentPtr newPtr = (StudentPtr)malloc(sizeof(Student));

    if (newPtr != NULL) {
        
        newPtr->id = id;
        strcpy_s(newPtr->name, name);
        newPtr->computer = comp;
        newPtr->math = math;
        newPtr->avg = ((double)comp + (double)math) / 2.0;
        newPtr->nextPtr = NULL;

        StudentPtr previousPtr = NULL;
        StudentPtr currentPtr = *sPtr;

        
        while (currentPtr != NULL && id > currentPtr->id) {
            previousPtr = currentPtr;
            currentPtr = currentPtr->nextPtr;
        }

        
        if (previousPtr == NULL) {
            newPtr->nextPtr = *sPtr;
            *sPtr = newPtr;
        }
        
        else {
            previousPtr->nextPtr = newPtr;
            newPtr->nextPtr = currentPtr;
        }
    }
    else {
        printf("無法配置記憶體 %d。\n", id);
    }
}

int isEmpty(StudentPtr sPtr) {
    return sPtr == NULL;
}

void printList(StudentPtr currentPtr) {
    if (isEmpty(currentPtr)) {
        puts("目前串列是空的。\n");
    }
    else {
        printf("%-10s %-15s %-10s %-10s %-10s\n","學號", "姓名", "電腦", "數學", "平均");        

        while (currentPtr != NULL) {
            printf("%-10d %-15s %-10d %-10d %-10.2f\n",
                currentPtr->id, currentPtr->name, currentPtr->computer,
                currentPtr->math, currentPtr->avg);
            currentPtr = currentPtr->nextPtr;
        }
        
    }
