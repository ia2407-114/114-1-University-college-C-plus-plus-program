#include <stdio.h>


int main(void)
{
	float 學生人數 = -1;
	float 成績;
	float 及格 = 0;
	float 不及格 = -1;
	float 平均;
	float 成績總和 = 0;
	do {
		printf("%s", "輸入學生成績:");
		scanf_s("%f", &成績);
		if (成績 >= 60) {
			及格 = 及格 + 1;
			成績總和 += 成績;
		}
		else {
			不及格 = 不及格 + 1;
			成績總和 += 成績;
		}
		學生人數 = 學生人數 + 1;

	} while (成績 > 0);
	printf("有%.0f個人及格\n", 及格);
	printf("有%.0f個不及格\n", 不及格);
	平均 = 成績總和 / 學生人數;
	printf("平均為%.2f\n", 平均);
	if (及格 / 學生人數 >= 0.5) {
		printf("Bouns to the  teacher!");


	}
}
