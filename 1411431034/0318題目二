#include <iostream>
using namespace std;

#include "value.h" 

int main()
{
	
	int int1, int2, int3;

	cout << "Input three integer values: ";
	cin >> int1 >> int2 >> int3;
	cout << "The integer value is:" << value(int1, int2, int3) << endl;

	
	

	float float1, float2, float3;

	cout << "\n\nInput three float values: ";
	cin >> float1 >> float2 >> float3;
	cout << "The float value is:" << value(float1, float2, float3) << endl;
	
	


	
	double double1, double2, double3;

	cout << "\n\nInput three double values: ";
	cin >> double1 >> double2 >> double3;
	cout << "The double value is:" << value(double1, double2, double3)<<endl;
	
	
}





