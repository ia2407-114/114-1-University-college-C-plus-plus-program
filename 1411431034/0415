#include "pet.h"
using namespace std;

int main()
{
    int y, m, d;

    for (int i = 1; i <= 3; i++)
    {
        string name, category;

        cout << "輸入名字: ";
        cin >> name;

        cout << "輸入品種: ";
        cin >> category;

        cout << "輸入生日: ";
        cin >> y >> m >> d;
        Date birth(y, m, d);

