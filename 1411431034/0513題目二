//主程式
#include "DerivedPets.h"
#include <iostream>

using namespace std;

int main() {
    // 建立 Dog 物件
    Dog myDog("小黑", 3, 5, 25.5);
    cout << "狗狗資料 -> ";
    myDog.printDogInfo();

    cout << "--------------------------" << endl;

    // 建立 Bird 物件
    Bird myBird("皮皮", 1, 3, 40.0);
    cout << "小鳥資料 -> ";
    myBird.printBirdInfo();

    cout << "--------------------------" << endl;

    return 0;
}

