#include <stdio.h>
#define SIZE 10

void sort_array(int stu[][SIZE], float avg[], int n) {
	int i, j, temp;
	float temp1;

	for (i = 0; i < n - 1; i++) {
		for (j = 0; j < n - 1 - i; j++) {
			if (avg[j] < avg[j + 1]) {

				temp = stu[0][j];
				stu[0][j] = stu[0][j + 1];
				stu[0][j + 1] = temp;

				temp = stu[1][j];
				stu[1][j] = stu[1][j + 1];
				stu[1][j + 1] = temp;

				temp = stu[2][j];
				stu[2][j] = stu[2][j + 1];
				stu[2][j + 1] = temp;

				temp1 = avg[j];
				avg[j] = avg[j + 1];
				avg[j + 1] = temp1;

			}
		}
	}
}


int main() {
	int stu[3][SIZE] ={ { 11, 15, 13, 18, 12, 17, 14, 19, 16, 20 },
					   { 85, 92, 78, 85, 90, 85, 76, 95, 88, 85 } ,
					   { 70, 80, 75, 90, 85, 70, 82, 92, 88, 70 } };

	float average_scores[SIZE];

	int i;

	printf("學號\t計概成績\t數學成績\t平均成績\n");
	for (i = 0; i < SIZE; i++) {
			
			average_scores[i] = (float)(stu[1][i]+stu[2][i]) / 2;
		}
	for (i = 0; i < SIZE; i++) {
		printf("%d\t %d\t\t %d\t\t %f\t\n", stu[0][i], stu[1][i], stu[2][i], average_scores[i]);
	}




	sort_array(stu, average_scores, SIZE);
	
	printf("學號\t計概成績\t數學成績\t平均成績\n");\

		for (i = 0; i < SIZE; i++) {
			printf("%d\t %d\t\t %d\t\t %f\t\n", stu[0][i], stu[1][i], stu[2][i], average_scores[i]);
		}

	return 0;
}
