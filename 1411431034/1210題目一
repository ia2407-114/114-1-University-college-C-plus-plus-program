#include <stdio.h>
#define SIZE 20


int main(void)
{
	
	int id[SIZE] = { 12,13,14,15,16,17,19,21,22,23,24,26,27,28,29,31,32,33,36,37 }, temp,i;
	int a[SIZE] = { 66,67,66,70,73,74,75,75,62,32,44,46,27,12,80,63,66,90,11,66 };
	puts("Data items in original order");

	
	for ( i = 0; i < SIZE; ++i) {
		printf("%4d", a[i]);
	}
	puts("");
	for ( i = 0; i < SIZE; ++i) {
		printf("%4d", id[i]);
	}
	
	for (unsigned int pass = 1; pass < SIZE; ++pass) {

		
		for ( i = 0; i < SIZE - 1; ++i) {

			
			if (a[i] > a[i + 1]) {
				temp = a[i];
				a[i] = a[i + 1];
				a[i + 1] = temp;
				temp = id[i];
				id[i] = id[i + 1];
				id[i + 1] = temp;
			}
		}
	}

	puts("\nData items in ascending order");
	puts("\nID     score");
	
	for ( i = 0; i < SIZE; ++i) {
		printf("%4d%8d\n", id[i], a[i]);
	}

	puts("");
}
