//實作檔

#include "Movie.h"
#include <fstream>
#include <iomanip>

using namespace std;

// 實作：輸入並儲存資料
void MovieManager::inputAndSaveMovies(int count) {
    ofstream writebinaryfile(filename, ios_base::out | ios_base::binary);
    if (writebinaryfile.fail()) {
        cerr << "錯誤：無法建立 " << filename << " 檔案！\n";
        exit(1);
    }

    CinemaData movie;
    cout << "=== 請輸入 " << count << " 筆電影資訊 ===\n";
    for (int i = 0; i < count; ++i) {
        cout << "\n第 " << i + 1 << " 筆電影：\n";
        cout << "電影名稱: ";
        cin >> movie.name;
        cout << "上映日期: ";
        cin >> movie.date;
        cout << "上映廳處: ";
        cin >> movie.place;
        cout << "票價: ";
        cin >> movie.price;

        // 寫入一筆結構資料到二進位檔案
        writebinaryfile.write(reinterpret_cast<char*>(&movie), sizeof(CinemaData));
    }

    writebinaryfile.close();
    if (writebinaryfile.fail()) {
        cerr << "錯誤：無法關閉 " << filename << " 檔案！\n";
        exit(1);
    }
}

//逐一印出編號與電影名稱
void MovieManager::displayAllTitles() {
    ifstream readbinaryfile(filename, ios_base::in | ios_base::binary);
    if (readbinaryfile.fail()) {
        cerr << "錯誤：無法開啟 " << filename << " 讀取資料！\n";
        exit(1);
    }

    CinemaData movie;
    int i = 1;

    cout << "=== 電影清單 ===\n";
    while (readbinaryfile.read(reinterpret_cast<char*>(&movie), sizeof(CinemaData))) {
        cout<< i <<"." << "電影名稱: " << movie.name << "\n";
        i++;
    }
    cout << "================\n\n";

    readbinaryfile.close();
}

//利用 seekg 讀取特定一筆完整資料
void MovieManager::displayMovieDetail(int index) {
    ifstream readbinaryfile(filename, ios_base::in | ios_base::binary);
    if (readbinaryfile.fail()) {
        cerr << "錯誤：無法開啟 " << filename << " 讀取詳細資料！\n";
        exit(1);
    }

    CinemaData movie;

    readbinaryfile.seekg(sizeof(CinemaData) * (index - 1), ios::beg);

    // 嘗試讀取該筆資料
    if (readbinaryfile.read(reinterpret_cast<char*>(&movie), sizeof(CinemaData))) {
        cout << "\n=== 第 " << index << " 筆電影詳細內容 ===\n";
        cout << "電影名稱: " << movie.name << "\n"
            << "上映日期: " << movie.date << "\n"
            << "上映廳處: " << movie.place << "\n"
            << "票價:     " << movie.price << " 元\n";
        cout << "===============================\n";
    }
    else {
        cout << "\n[提示] 查無此電影資料（輸入的編號可能超出範圍）！\n";
    }

    readbinaryfile.close();
}

//介面檔

#ifndef MOVIE_H
#define MOVIE_H

#include <iostream>

// 定義電影資料的結構（確保二進位寫入時的大小固定）
struct CinemaData {
    char name[10];  // 電影名稱
    char date[9];   // 上映日期
    char place[7];  // 上映廳處
    int price;      // 票價
};

class MovieManager {
private:
    const std::string filename = "movie.bin";

public:
    // 從鍵盤讀取指定數量的電影並寫入二進位檔案
    void inputAndSaveMovies(int count);

    // 讀取並只顯示所有電影的編號與名稱
    void displayAllTitles();

    // 根據編號（從 1 開始）讀取並顯示該筆電影的完整詳細資料
    void displayMovieDetail(int index);
};

#endif // MOVIE_H
