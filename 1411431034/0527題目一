#include "Shape.h" // 導入介面，主程式才能看見類別定義
using namespace std;
int main() {
	Shape* a1;
	cone a(5,3);
	Sphere b(4);
	cylinder c(5, 3);
	a1 = &a;
	cout << "圓錐體體積：" << a1->volume() << endl;
	a1 = &b;
	cout << "球體體積：" << a1->volume() << endl;
