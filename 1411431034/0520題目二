{
    cout << "\n實作一名教師:\n";
    cout << "教師編號:";
    cin >> id;
    cout << "教師姓名:";
    cin >> name;
}

void teacher::data_input()
{
    cout << "課程編號:";
    cin >> course_id;
    cout << "課程名稱:";
