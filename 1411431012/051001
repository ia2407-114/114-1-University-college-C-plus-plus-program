#include <stdio.h>

// function main begins program execution 
int main(void)
{
	int p, r, q, w, x, y, z;

	printf("Enter p integer\n"); // prompt
	scanf_s("%d", &p);
	printf("Enter r integer\n"); // prompt
	scanf_s("%d", &r);
	printf("Enter q integer\n"); // prompt
	scanf_s("%d", &q);
	printf("Enter w integer\n"); // prompt
	scanf_s("%d", &w);
	printf("Enter x integer\n"); // prompt
	scanf_s("%d", &x);
	printf("Enter y integer\n"); // prompt
	scanf_s("%d", &y);
	
	z = p * r % q + w / x - y;

	printf("%d plus %d and the sum is %d\n", p, r, q, w, x, y, z);
	return 1;
}
