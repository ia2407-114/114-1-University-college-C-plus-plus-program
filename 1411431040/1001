#include <stdio.h>
int main(void)
{
    int p, r, q, w, x, y, z;
    printf("Enter p: ");
    scanf_s("%d", &p);
    printf("Enter r: ");
    scanf_s("%d", &r);
    printf("Enter q: ");
    scanf_s("%d", &q);
    printf("Enter w: ");
    scanf_s("%d", &w);
    printf("Enter x: ");
    scanf_s("%d", &x);
    printf("Enter y: ");
    scanf_s("%d", &y);

    z = p * r % q + w / x - y;

	printf("z = %d * %d %% %d + %d / %d - %d = %d\n", p, r, q, w, x, y, z);

	return 0;
}






