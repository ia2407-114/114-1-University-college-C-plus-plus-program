#include <stdio.h>

int main(void)
{
    double p; 
    double r;     
    double aims;      
    double amount;    
    int year = 0;    

    printf("輸入本金: ");
    scanf_s("%lf", &p);
    printf("輸入利率 (.05): ");
    scanf_s("%lf", &r);
    printf("輸入目標: ");
    scanf_s("%lf", &aims);

    amount = p;

    printf("\nYear\tAmount\n");

    while (amount < aims) {
        year = year + 1;                
        amount = amount * (1.0 + r);
        printf("%4d\t%.2f\n", year, amount);
    }

    printf("\n需要%d年才能達到存款金額%.2f\n", year, aims);

    return 0;
}






#include <stdio.h>

int main(void)
{
    double p;
    double r;
    double deposit;
    double aims;
    double amount;
    int year = 0;

    printf("輸入本金: ");
    scanf_s("%lf", &p);
    printf("輸入利率(.05): ");
    scanf_s("%lf", &r);
    printf("輸入過年存款: ");
    scanf_s("%lf", &deposit);
    printf("輸入目標: ");
    scanf_s("%lf", &aims);

    amount = p;

    printf("\nYear\tAmount\n");

    while (amount < aims) {
        year = year + 1;
        amount = amount * (1.0 + r) + deposit;
        printf("%4d\t%.2f\n", year, amount);
    }

    printf("\n需要%d才會達到目標%.2f\n", year, aims);

    return 0;
}
