#include<stdio.h>

int main(void)
{
	int a, b, c;
	printf("Enter three different integers: \n");
	scanf_s("%d %d %d", &a, &b, &c);

	printf("Sum is %d\n", a + b + c);
	printf("Average is %.2f\n", ((float)(a + b + c) / 3));
	printf("The Product is %d\n", a * b * c);
	int largest = a;

	if (b > largest)
		largest = b;
	if (c > largest)
		largest = c;

	printf("Largest is %d\n", largest);

	return 0;
}









#include <stdio.h>

int main(void)
{
	float weight, height, bmi;

	printf("Enter your weight: ");
	scanf_s("%f", &weight);

	printf("Enter your height in meters: ");
	scanf_s("%f", &height);

	bmi = weight / (height * height);

	printf("\nYour BMI is: %.2f\n", bmi);
	if (bmi < 18.5)
		printf("underweight.\n");
	else if (bmi < 25.0)
		printf("normal .\n");
	else if (bmi < 30.0)
		printf("overweight.\n");
	else
		printf("obese.\n");

	return 0;
}










